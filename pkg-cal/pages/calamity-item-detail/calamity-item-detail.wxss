@import "../../style/cal-common.wxss";

/* ===== 头图 hero（对齐原版 detail 页布局，灾厄红配色） ===== */
.hero {
  position: relative; z-index: 2;
  display: flex; flex-direction: column; align-items: center;
  padding: 24rpx 40rpx 30rpx;
  border-radius: 20rpx;
  background: radial-gradient(70% 90% at 50% 0%, rgba(224, 82, 82, 0.18) 0%, transparent 70%);
  overflow: hidden;
}
.hero-glow {
  position: absolute; top: -30rpx; width: 420rpx; height: 320rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(224, 82, 82, 0.22) 0%, transparent 65%);
  opacity: 0.6; pointer-events: none;
}
.hero-art { position: relative; z-index: 1; filter: drop-shadow(0 8rpx 30rpx rgba(0, 0, 0, 0.55)); }
.hero-img { width: 200rpx; height: 200rpx; }
.hero-tile {
  width: 200rpx; height: 200rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 24rpx; background: rgba(224, 82, 82, 0.14);
  border: 2rpx solid rgba(224, 82, 82, 0.35);
}
.hero-tile-t { font-size: 84rpx; font-weight: 800; color: #FF9C8A; }
.hero-meta { display: flex; align-items: center; margin-top: 22rpx; }
.tag {
  font-size: 20rpx; color: #FF9C8A; letter-spacing: 2rpx;
  border: 2rpx solid rgba(224, 82, 82, 0.5); background: rgba(224, 82, 82, 0.12);
  padding: 4rpx 16rpx; border-radius: 8rpx;
}
.hero-en { font-size: 20rpx; color: var(--text-faint); margin-left: 16rpx; letter-spacing: 2rpx; }
.hero-name { margin-top: 14rpx; font-size: 44rpx; font-weight: 800; color: var(--text); text-align: center; }

/* ===== 主体 ===== */
.body { position: relative; z-index: 2; }

/* 关键数据：2 列网格（对齐原版 stat-grid，灾厄配色） */
.stat-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.stat { min-width: 0; padding: 18rpx 24rpx; display: flex; flex-direction: column; box-sizing: border-box; }
.st-k { font-size: 20rpx; color: var(--text-dim); }
.st-v { font-size: 28rpx; color: #FFD24A; font-weight: 800; margin-top: 8rpx; word-break: break-all; }

/* 物品效果（官方提示） */
.tipbox { padding: 22rpx 24rpx; }
.tip-line { display: block; font-size: 26rpx; line-height: 1.7; color: var(--text); }
.tipbox .tip-line:not(:first-child) { margin-top: 10rpx; color: var(--text-dim); }

/* 效果详解：Wiki 核录条目卡（对齐原版 tip 卡布局，灾厄红角标） */
.dtl { display: flex; align-items: flex-start; padding: 16rpx 22rpx; margin-bottom: 14rpx; }
.dtl-i {
  flex-shrink: 0; font-size: 18rpx; color: #3A1410;
  background: #E85555; padding: 2rpx 10rpx; border-radius: 6rpx; margin-right: 16rpx;
  font-weight: 700;
}
.dtl-t { font-size: 25rpx; color: var(--text-dim); line-height: 1.7; }
.sec-more { margin-left: auto; font-size: 20rpx; color: var(--text-faint); }

/* 获取方式正文（对齐原版 obtain line 卡；物品名可点击，灾厄金配色） */
.ob-line { padding: 20rpx 26rpx; margin-bottom: 16rpx; font-size: 25rpx; color: var(--text-dim); line-height: 1.7; }
.lnk { color: #FFD24A; font-weight: 700; border-bottom: 2rpx solid rgba(255, 210, 74, 0.45); }

/* 来源 Boss 入口卡 */
.src {
  position: relative; display: flex; align-items: center;
  padding: 22rpx 24rpx; margin-bottom: 8rpx;
}
.src-col { min-width: 0; }
.src-t { font-size: 27rpx; font-weight: 800; color: var(--gold); }
.src-s { display: block; font-size: 20rpx; color: var(--text-faint); margin-top: 6rpx; }
.src-go { color: var(--gold); font-size: 36rpx; margin-left: 16rpx; }

/* ===== 底部悬浮按钮（对齐原版 float-btns，灾厄配色） ===== */
.float-btns {
  position: fixed; left: 30rpx; right: 30rpx;
  bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  display: flex; z-index: 90; gap: 16rpx;
}
.fb {
  flex: 1; display: flex; align-items: center; justify-content: center;
  height: 88rpx; font-size: 27rpx; font-weight: 700;
  border-radius: 16rpx; margin: 0;
}
.fb-back { background: var(--bg-deep); border: 2rpx solid rgba(224, 82, 82, 0.5); color: #FF9C8A; }
.fb-share { background: linear-gradient(180deg, #FF7A66, #E05252); color: #FFF4F0; }
.fb-share::after { border: none; }
.safe-bottom { padding-bottom: 0; }

.pad-bottom { height: 140rpx; }

/* 未找到 */
.miss { margin: 30rpx 0; padding: 30rpx; text-align: center; }
.miss-t { font-size: 26rpx; color: var(--text-faint); }
