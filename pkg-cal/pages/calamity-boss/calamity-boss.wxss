@import "../../style/cal-common.wxss";

/* 显式分享入口（open-type=share）：灾厄红配色，对齐 cal-common hero 风格 */
.share-cta {
  display: block;
  width: 100%;
  margin: 20rpx 0 4rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #FF9C8A;
  background: rgba(224, 82, 82, 0.14);
  border: 2rpx solid rgba(224, 82, 82, 0.4);
  border-radius: 16rpx;
}
.share-cta::after { border: none; }

/* 掉落物内嵌链接（对齐原版 detail 页 lnk，灾厄金配色） */
.lnk { color: #FFD24A; font-weight: 700; border-bottom: 2rpx solid rgba(255, 210, 74, 0.45); }
.d-hint { margin-left: auto; font-size: 20rpx; color: var(--text-faint); }

/* 深度攻略入口卡（二期模块 B） */
.strat-cta {
  display: flex; align-items: center;
  padding: 22rpx 24rpx; margin-top: 16rpx;
  border: 2rpx solid rgba(224, 82, 82, 0.45); border-radius: 16rpx;
  background: linear-gradient(120deg, rgba(224, 82, 82, 0.14), rgba(122, 66, 204, 0.10));
}
.strat-t { font-size: 27rpx; font-weight: 800; color: #FF9C8A; }
.strat-s { display: block; font-size: 20rpx; color: var(--text-faint); margin-top: 6rpx; }
.strat-go { color: #FF9C8A; font-size: 36rpx; margin-left: 16rpx; }
