/* 灾厄专区通用样式（原版/灾厄双世界架构） */
.cal-root { min-height: 100vh; padding: 0 24rpx 40rpx; box-sizing: border-box; }

.nav { display: flex; align-items: center; height: 88rpx; margin-bottom: 12rpx; position: sticky; top: 0; z-index: 50; background: var(--head-bg, var(--bg)); }
.back { width: 64rpx; height: 64rpx; line-height: 60rpx; text-align: center; font-size: 44rpx; color: var(--text); border: 2rpx solid var(--line); border-radius: 14rpx; background: var(--card); }
.nav-t { flex: 1; text-align: center; font-size: 32rpx; font-weight: 800; color: var(--text); }
.nav-ph { width: 64rpx; }

.hero { display: flex; flex-direction: column; padding: 22rpx 26rpx; margin-bottom: 16rpx; border: 2rpx solid rgba(224, 82, 82, 0.35); border-radius: 20rpx; background: linear-gradient(120deg, rgba(224, 82, 82, 0.16), rgba(122, 66, 204, 0.10)); }
.hero-t { font-size: 26rpx; color: #FF9C8A; letter-spacing: 4rpx; }
.hero-s { font-size: 24rpx; color: var(--text); margin-top: 8rpx; }
.hero-stat { font-size: 20rpx; color: var(--text-dim); margin-top: 8rpx; }

.mode-strip { display: block; font-size: 20rpx; color: var(--text-dim); padding: 6rpx 4rpx 0; line-height: 1.5; }

.stage-head { display: flex; align-items: center; margin: 30rpx 4rpx 14rpx; }
.stage-t { font-size: 30rpx; font-weight: 800; color: var(--text); }
.stage-en { font-size: 20rpx; color: var(--text-dim); margin-left: 14rpx; letter-spacing: 2rpx; }

.b-row { display: flex; align-items: center; padding: 18rpx 20rpx; margin-bottom: 14rpx; border: 2rpx solid var(--line); border-radius: 16rpx; background: var(--card); }
.b-nameline { display: flex; align-items: center; flex-wrap: wrap; }
.b-n { font-size: 28rpx; font-weight: 800; color: var(--text); }
.b-en { font-size: 20rpx; color: var(--text-dim); margin-left: 12rpx; }
.b-world { font-size: 18rpx; margin-left: 12rpx; padding: 2rpx 10rpx; border-radius: 8rpx; color: #E85555; border: 2rpx solid rgba(232, 85, 85, 0.4); }
.b-one { display: block; font-size: 22rpx; color: var(--text-dim); margin-top: 8rpx; line-height: 1.5; }
.b-arrow { font-size: 34rpx; color: var(--text-dim); margin-left: 16rpx; }

.mb-box { padding: 16rpx 20rpx; }
.mb-row { display: flex; padding: 12rpx 4rpx; border-bottom: 2rpx solid var(--line); }
.mb-row:last-child { border-bottom: none; }
.mb-n { width: 200rpx; font-size: 24rpx; color: var(--text); font-weight: 500; flex-shrink: 0; }
.mb-d { flex: 1; font-size: 22rpx; color: var(--text-dim); line-height: 1.5; }
.mb-note { font-size: 20rpx; color: var(--text-dim); margin-top: 14rpx; display: block; }

.guide-card { padding: 24rpx; margin-top: 28rpx; }
.g-t { font-size: 28rpx; font-weight: 800; color: var(--text); display: block; }
.g-s { font-size: 22rpx; color: var(--text-dim); margin-top: 10rpx; display: block; line-height: 1.5; }

.d-head { padding: 8rpx 4rpx 4rpx; display: flex; align-items: center; }
/* 速查详情头图：官方 Boss 图标 110rpx，与名称/徽标列并排 */
.d-ico { width: 110rpx; height: 110rpx; margin-right: 22rpx; flex-shrink: 0; filter: drop-shadow(0 0 14rpx rgba(224, 82, 82, 0.25)); }
.d-headcol { flex: 1; min-width: 0; }
.d-nameline { display: flex; align-items: center; flex-wrap: wrap; }
.d-name { font-size: 42rpx; font-weight: 800; color: var(--text); }
.d-en { font-size: 24rpx; color: var(--text-dim); margin-left: 16rpx; }
.d-badges { display: flex; margin-top: 12rpx; }
.d-badge { font-size: 20rpx; color: var(--text-dim); border: 2rpx solid var(--line); border-radius: 8rpx; padding: 4rpx 14rpx; margin-right: 12rpx; }
.d-badge.warn { color: #E85555; border-color: rgba(232, 85, 85, 0.4); }

.sec-title { display: flex; align-items: center; margin: 30rpx 4rpx 14rpx; }
.diamond { width: 14rpx; height: 14rpx; background: var(--gold, #FFD700); transform: rotate(45deg); margin-right: 14rpx; }
.sec-t { font-size: 28rpx; font-weight: 800; color: var(--text); }

.summon-box { padding: 20rpx 24rpx; border: 2rpx solid var(--line); border-radius: 14rpx; background: var(--card); font-size: 24rpx; color: var(--text); line-height: 1.7; }
/* 基本信息区块：Wiki 数据行 */
.info-box { padding: 8rpx 24rpx; }
.info-row { display: flex; padding: 12rpx 0; border-bottom: 2rpx solid var(--line); align-items: flex-start; }
.info-row:last-child { border-bottom: none; }
.info-k { width: 190rpx; font-size: 23rpx; color: var(--text-dim); flex-shrink: 0; }
.info-v { flex: 1; font-size: 24rpx; color: var(--gold, #FFD700); font-weight: 600; line-height: 1.5; word-break: break-all; }
.p-box { padding: 20rpx 24rpx; }
.p-item { display: block; font-size: 24rpx; color: var(--text); line-height: 1.7; margin-bottom: 10rpx; }

.next-row { display: flex; align-items: center; padding: 20rpx 24rpx; margin-top: 4rpx; border: 2rpx solid rgba(255, 215, 0, 0.35); border-radius: 16rpx; background: var(--card); }
.next-ico { width: 72rpx; height: 72rpx; margin-right: 20rpx; flex-shrink: 0; }
.next-n { font-size: 28rpx; font-weight: 800; color: var(--gold, #FFD700); }
.next-en { font-size: 20rpx; color: var(--text-dim); margin-left: 12rpx; }

.faq-box { padding: 20rpx 24rpx; }
.faq-item { padding: 12rpx 0; border-bottom: 2rpx solid var(--line); }
.faq-item:last-child { border-bottom: none; }
.faq-q { display: block; font-size: 24rpx; font-weight: 800; color: var(--text); }
.faq-a { display: block; font-size: 23rpx; color: var(--text-dim); line-height: 1.7; margin-top: 8rpx; }

.foot { padding: 28rpx 0 6rpx; text-align: center; font-size: 20rpx; color: var(--text-dim); }
.col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; }

/* Boss 卡片网格（二级列表页 calamity-list 用）：2 列，官方 Boss 图标 + 中文名 + 专属角标 */
.b-grid { display: flex; flex-wrap: wrap; justify-content: space-between; margin: 0 2rpx; }
.b-card {
  position: relative; width: 49%; box-sizing: border-box;
  padding: 26rpx 14rpx 20rpx; margin-bottom: 16rpx;
  border: 2rpx solid var(--line); border-radius: 18rpx; background: var(--card);
  display: flex; flex-direction: column; align-items: center;
  transition: transform 0.12s ease-out;
}
.b-card:active { transform: scale(0.96); }
/* 官方图标：深色卡底衬托，96rpx 显示区（原图 128px，2~3x retina 足够） */
.b-img { width: 96rpx; height: 96rpx; margin-bottom: 14rpx; }
.b-n { font-size: 27rpx; font-weight: 800; color: var(--text); margin-top: 0; text-align: center; }
.b-en { font-size: 18rpx; color: var(--text-faint); margin-top: 6rpx; text-align: center; }
.b-world {
  position: absolute; top: 10rpx; right: 10rpx;
  font-size: 16rpx; line-height: 1.4; padding: 2rpx 8rpx; border-radius: 6rpx;
}
.b-world.corruption { color: #C77DFF; background: rgba(199, 125, 255, 0.14); border: 1rpx solid rgba(199, 125, 255, 0.45); }
.b-world.crimson { color: #FF9E6B; background: rgba(255, 158, 107, 0.14); border: 1rpx solid rgba(255, 158, 107, 0.45); }
