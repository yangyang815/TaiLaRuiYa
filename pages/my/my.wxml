<view class="page-root {{themeClass}} my-root">

  <!-- 品牌区 -->
  <view class="head" style="padding-top:{{navTop}}px;">
    <view class="brand-row">
      <view class="logo">
        <pixel-icon art-id="{{avatarArtId}}" size="64" />
        <view class="col">
          <text class="logo-t px">TERRA HANDBOOK</text>
          <text class="logo-s">冒険者の手記</text>
        </view>
      </view>
      <view class="clock px">{{clock}}</view>
    </view>
  </view>

  <!-- 用户信息卡 -->
  <view class="user-card card card-gold">
    <view class="u-row">
      <view class="ava tappable" bindtap="openAvas">
        <pixel-icon art-id="{{avatarArtId}}" size="132" />
        <view class="ava-edit px">改</view>
      </view>
      <view class="col flex-1">
        <view class="row" wx:if="{{!editingNick}}" bindtap="startEditNick">
          <text class="nick">{{profile.nick}}</text>
          <text class="nick-edit">✎</text>
        </view>
        <view class="row" wx:else>
          <input class="nick-input" value="{{nickDraft}}" bindinput="onNick" focus maxlength="12" />
          <view class="btn-gold nick-save" bindtap="saveNick">保存</view>
        </view>
        <view class="lv-line">
          <text class="lv px">⭐ LV.{{level.lv}}</text>
          <text class="lv-title">{{level.title}}</text>
        </view>
        <text class="sig">“{{signature}}”</text>
        <view class="lv-bar">
          <view class="lv-fill" style="width: {{level.cur / level.need * 100}}%;" />
        </view>
        <view class="u-ops">
          <text class="lv-tip flex-1">冒险值 {{level.cur}}/{{level.need}}</text>
          <view class="card-share tappable" bindtap="openPoster">▣ 名片</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 数据统计三卡片 -->
  <view class="stat-row">
    <view class="stat card tappable" bindtap="goBosses">
      <text class="st-icon">⚔️</text>
      <text class="st-t">Boss</text>
      <text class="st-v">{{bossN}} <text class="st-sub">/ {{bossTotal}}</text></text>
    </view>
    <view class="stat card tappable" bindtap="goFavs">
      <text class="st-icon">📦</text>
      <text class="st-t">收藏</text>
      <text class="st-v">{{favCount}} <text class="st-sub">个</text></text>
    </view>
    <view class="stat card tappable" bindtap="goNotes">
      <text class="st-icon">📝</text>
      <text class="st-t">笔记</text>
      <text class="st-v">{{noteCount}} <text class="st-sub">篇</text></text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu card">
    <view class="m-row tappable" bindtap="goFavs">
      <text class="m-icon">❤️</text>
      <text class="m-n flex-1">我的收藏</text>
      <text class="m-v">{{favCount}} 个</text>
      <text class="m-arrow">›</text>
    </view>
    <view class="m-row tappable" bindtap="goNotes">
      <text class="m-icon">📝</text>
      <text class="m-n flex-1">我的笔记</text>
      <text class="m-v">{{noteCount}} 篇</text>
      <text class="m-arrow">›</text>
    </view>
    <view class="m-row tappable" bindtap="goAchv">
      <text class="m-icon">🏆</text>
      <text class="m-n flex-1">冒险成就</text>
      <text class="m-v">已解锁 {{achvUnlocked}}/{{achvTotal}}</text>
      <text class="m-arrow">›</text>
    </view>
    <view class="m-row tappable" bindtap="goGameAchv">
      <text class="m-icon">🥇</text>
      <text class="m-n flex-1">泰拉成就</text>
      <text class="m-v">已达成 {{gAchvDone}}/{{gAchvTotal}}</text>
      <text class="m-arrow">›</text>
    </view>
    <view class="m-row tappable" bindtap="goFishing">
      <text class="m-icon">🎣</text>
      <text class="m-n flex-1">钓鱼图鉴</text>
      <text class="m-v">已收集 {{fishDone}}/{{fishTotal}}</text>
      <text class="m-arrow">›</text>
    </view>
  </view>

  <view class="menu card">
    <view class="m-row">
      <text class="m-icon">⚙️</text>
      <text class="m-n flex-1">游戏版本</text>
      <picker class="ver-picker" range="{{versions}}" value="{{versionIndex}}" bindchange="onVersion">
        <view class="ver px">{{version}} ▼</view>
      </picker>
    </view>
    <view class="m-row">
      <text class="m-icon">🌙</text>
      <text class="m-n flex-1">夜间模式</text>
      <switch checked="{{dark}}" bindchange="onTheme" color="#FFD700" />
    </view>
  </view>

  <view class="menu card">
    <view class="m-row tappable" bindtap="resetData">
      <text class="m-icon">📊</text>
      <text class="m-n flex-1">重置数据</text>
      <text class="m-v">清除本地记录</text>
    </view>
    <view class="m-row tappable" bindtap="openAbout">
      <text class="m-icon">💬</text>
      <text class="m-n flex-1">关于与反馈</text>
      <text class="m-v">v1.0.0</text>
      <text class="m-arrow">›</text>
    </view>
  </view>

  <view class="foot px">TERRA HANDBOOK · v1.0</view>
  <view class="pad-bottom" />

  <!-- 头像选择 -->
  <view class="mask" wx:if="{{showAvas}}" bindtap="closeAvas" />
  <view class="sheet" wx:if="{{showAvas}}" catchtap="noop">
    <view class="sheet-handle" />
    <view class="ava-grid">
      <view class="ava-cell card tappable {{profile.avatar === item.k ? 'on' : ''}}"
        wx:for="{{avatars}}" wx:key="k" bindtap="pickAva" data-k="{{item.k}}">
        <pixel-icon art-id="{{item.k}}" size="100" />
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="mask" wx:if="{{showAbout}}" bindtap="closeAbout" />
  <view class="sheet" wx:if="{{showAbout}}" catchtap="noop">
    <view class="sheet-handle" />
    <view class="about">
      <view class="ab-logo"><pixel-icon art-id="{{avatarArtId}}" size="120" /></view>
      <text class="ab-t px">TERRA HANDBOOK</text>
      <text class="ab-v">v1.0 · 数据基准 Terraria {{version}}</text>
      <view class="hr" />
      <text class="ab-line">· 图鉴 / 合成 / 攻略数据参考泰拉瑞亚 Wiki（1.4.4 基准）</text>
      <text class="ab-line">· 本小程序为玩家自制学习作品，与 Re-Logic 无关</text>
      <text class="ab-line">· 反馈建议：在各大应用市场或微信"关于"中留言</text>
      <view class="btn-gold ab-btn" bindtap="closeAbout">继续冒险</view>
    </view>
  </view>

  <!-- 分享海报（冒险者名片） -->
  <poster show="{{posterShow}}" info="{{posterData}}" bind:close="closePoster" />
</view>
