/* 我的页：品牌区 / 用户信息卡 / 数据统计 / 功能列表 */
.my-root { min-height: 100vh; }

/* 品牌区 */
.head { padding: 16rpx 30rpx 0; }
.brand-row { display: flex; align-items: center; justify-content: space-between; padding: 4rpx 0 16rpx; }
.logo { display: flex; align-items: center; }
.logo-t { font-size: 22rpx; color: var(--gold); font-weight: 800; letter-spacing: 2rpx;
  text-shadow: 0 0 14rpx rgba(255, 215, 0, 0.5); }
.logo-s { font-size: 20rpx; color: var(--text-dim); margin-top: 4rpx; letter-spacing: 3rpx; }
.clock { font-size: 26rpx; color: var(--gold); font-weight: 700; letter-spacing: 2rpx; }

/* 用户信息卡 */
.user-card {
  margin: 8rpx 30rpx 0; padding: 30rpx 28rpx;
  background:
    radial-gradient(80% 60% at 15% 0%, rgba(255, 215, 0, 0.1), transparent 70%),
    radial-gradient(70% 60% at 90% 10%, rgba(94, 60, 154, 0.25), transparent 70%);
}
.u-row { display: flex; align-items: center; }
.ava { position: relative; width: 152rpx; height: 152rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center; margin-right: 28rpx; flex-shrink: 0; }
.ava-edit { position: absolute; bottom: -10rpx; right: -10rpx; font-size: 16rpx;
  color: #3A2400; background: var(--gold); border-radius: 8rpx; padding: 4rpx 10rpx;
  box-shadow: 0 0 12rpx rgba(255, 215, 0, 0.5); }
.nick { font-size: 36rpx; font-weight: 900; color: var(--text); }
.nick-edit { margin-left: 14rpx; color: var(--gold); font-size: 26rpx; }
.nick-input { flex: 1; font-size: 32rpx; color: var(--text); font-weight: 800; }
.nick-save { padding: 8rpx 24rpx; font-size: 22rpx; margin-left: 16rpx; }
.lv-line { display: flex; align-items: baseline; margin-top: 12rpx; }
.lv { font-size: 24rpx; color: var(--gold); text-shadow: 0 0 10rpx rgba(255, 215, 0, 0.4); }
.lv-title { font-size: 24rpx; color: var(--text-dim); margin-left: 14rpx; }
.sig { font-size: 22rpx; color: var(--text-dim); margin-top: 10rpx; font-style: italic; }
.lv-bar { height: 16rpx; border-radius: 8rpx; background: rgba(0, 0, 0, 0.4);
  border: 2rpx solid var(--gold-faint); margin-top: 14rpx; overflow: hidden; }
.lv-fill { height: 100%; border-radius: 8rpx;
  background: linear-gradient(90deg, #B8860B, #FFD700);
  box-shadow: 0 0 14rpx rgba(255, 215, 0, 0.6);
  transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
.u-ops { display: flex; align-items: center; margin-top: 8rpx; }
.lv-tip { font-size: 20rpx; color: var(--text-faint); }

/* 名片海报入口 */
.card-share {
  display: inline-flex; align-items: center; align-self: flex-start;
  padding: 10rpx 24rpx; border-radius: 999rpx;
  font-size: 22rpx; font-weight: 800; color: #3A2400;
  background: linear-gradient(180deg, #FFE55C, #E5B800);
  border: 2rpx solid #FFF0B0;
  box-shadow: 0 6rpx 20rpx rgba(255, 200, 60, 0.35);
}

/* 数据统计三卡片 */
.stat-row { display: flex; gap: 16rpx; padding: 24rpx 30rpx 0; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 22rpx 8rpx 20rpx; }
.st-icon { font-size: 40rpx; }
.st-t { font-size: 20rpx; color: var(--text-faint); margin-top: 8rpx; letter-spacing: 2rpx; }
.st-v { font-size: 34rpx; font-weight: 900; color: var(--gold); margin-top: 6rpx;
  text-shadow: 0 0 12rpx rgba(255, 215, 0, 0.4); }
.st-sub { font-size: 20rpx; color: var(--text-faint); font-weight: 400; }

/* 功能列表 */
.menu { margin: 24rpx 30rpx 0; padding: 4rpx 26rpx; }
.menu:first-of-type { margin-top: 28rpx; }
.m-row { display: flex; align-items: center; padding: 26rpx 0; }
.m-row + .m-row { border-top: 2rpx solid var(--line); }
.m-icon { font-size: 34rpx; margin-right: 20rpx; }
.m-n { font-size: 27rpx; color: var(--text); font-weight: 700; }
.m-v { font-size: 22rpx; color: var(--text-faint); margin-left: 12rpx; }
.m-arrow { color: var(--gold); font-size: 34rpx; margin-left: 8rpx; }
.ver-picker { margin-left: 12rpx; }
.ver { display: inline-flex; align-items: center; font-size: 22rpx; color: var(--gold);
  font-weight: 800; border: 2rpx solid var(--gold-faint); border-radius: 999rpx;
  padding: 8rpx 22rpx; }

.foot { text-align: center; font-size: 16rpx; color: var(--text-faint);
  padding: 50rpx 0 10rpx; letter-spacing: 4rpx; }
.pad-bottom { height: 180rpx; }

/* 头像弹窗 */
.ava-grid { display: flex; flex-wrap: wrap; padding: 20rpx 40rpx 40rpx; gap: 24rpx; }
.ava-cell { width: calc((100% - 48rpx) / 3); height: 140rpx; display: flex;
  align-items: center; justify-content: center; }
.ava-cell.on { border-color: var(--gold); box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.35); }

/* 关于 */
.about { padding: 20rpx 44rpx 40rpx; display: flex; flex-direction: column; align-items: center; }
.ab-logo { margin-bottom: 16rpx; filter: drop-shadow(0 0 16rpx rgba(255, 215, 0, 0.4)); }
.ab-t { font-size: 24rpx; color: var(--gold); letter-spacing: 2rpx; }
.ab-v { font-size: 22rpx; color: var(--text-faint); margin-top: 10rpx; }
.about .hr { width: 100%; }
.about { text-align: left; }
.ab-line { font-size: 23rpx; color: var(--text-dim); line-height: 2; align-self: flex-start; }
.ab-btn { margin-top: 30rpx; }

/* 存档备份：导入面板与二维码 */
.import-panel { margin: -8rpx 0 20rpx; padding: 20rpx 24rpx; }
.ip-t { display: block; font-size: 21rpx; color: var(--text-faint); line-height: 1.6; }
.ip-area { width: 100%; box-sizing: border-box; height: 160rpx; margin-top: 14rpx;
  padding: 14rpx; font-size: 22rpx; color: var(--text);
  background: rgba(0, 0, 0, 0.25); border: 2rpx solid var(--line); border-radius: 10rpx; }
.ip-ph { color: var(--text-faint); }
.ip-btns { display: flex; gap: 16rpx; margin-top: 16rpx; }
.ip-btn { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 12rpx;
  font-size: 24rpx; font-weight: 700; color: var(--gold);
  border: 2rpx solid var(--gold-faint); background: rgba(255, 215, 0, 0.07); }
.ip-btn.primary { color: #0E2A33; background: #4CE0E0; border-color: #4CE0E0; }

.qr-t { display: block; text-align: center; font-size: 22rpx; color: var(--gold); letter-spacing: 2rpx; }
.qr-canvas { display: block; width: 420rpx; height: 420rpx; margin: 20rpx auto 0;
  border: 4rpx solid #FFFFFF; border-radius: 8rpx; background: #FFFFFF; }
.qr-hint { display: block; margin-top: 16rpx; font-size: 20rpx; color: var(--text-faint);
  text-align: center; line-height: 1.6; }
.qr-btn { margin-top: 20rpx; }
