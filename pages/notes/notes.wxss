/* 我的笔记页 */
.notes-root { min-height: 100vh; }

.nav { display: flex; align-items: center; padding: 12rpx 24rpx; position: sticky; top: 0; z-index: 50; }
.back { width: 64rpx; height: 64rpx; border-radius: 14rpx; border: 2rpx solid var(--gold-faint);
  background: rgba(10, 5, 24, 0.5); color: var(--gold); font-size: 40rpx;
  display: flex; align-items: center; justify-content: center; line-height: 1; padding-bottom: 6rpx; }
.nav-t { flex: 1; text-align: center; font-size: 30rpx; font-weight: 800; color: var(--text);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 0 10rpx; }
.nav-ph { width: 64rpx; }

/* 笔记列表 */
.note-list { padding: 16rpx 30rpx 0; }
.note { padding: 20rpx 24rpx; margin-bottom: 16rpx; }
.n-title { font-size: 28rpx; color: var(--gold); font-weight: 800; }
.n-del { padding: 6rpx; font-size: 26rpx; opacity: 0.7; }
.n-content { display: block; font-size: 24rpx; color: var(--text-dim); line-height: 1.7; margin-top: 10rpx; }
.n-time { font-size: 16rpx; color: var(--text-faint); margin-top: 12rpx; }

/* 新建悬浮按钮 */
.fab { position: fixed; right: 40rpx; bottom: calc(env(safe-area-inset-bottom) + 40rpx);
  padding: 22rpx 40rpx; border-radius: 999rpx; font-size: 27rpx; font-weight: 800;
  box-shadow: 0 10rpx 30rpx rgba(255, 215, 0, 0.35); z-index: 60; }

/* 编辑弹窗 */
.note-edit { padding: 10rpx 34rpx 30rpx; }
.ne-title { font-size: 30rpx; font-weight: 800; margin-bottom: 20rpx; }
.ne-content { width: 100%; min-height: 240rpx; line-height: 1.7; box-sizing: border-box; }
.ne-btns { margin-top: 26rpx; }
