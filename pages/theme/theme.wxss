.tp-root { min-height: 100vh; background: var(--bg-deep); }
.tp-head { display: flex; align-items: center; gap: 20rpx; padding: 0 30rpx 20rpx; background: var(--bg-2); border-bottom: 2rpx solid var(--line); }
.tp-back { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--card); border: 2rpx solid var(--line);
  display: flex; align-items: center; justify-content: center; font-size: 40rpx; color: var(--text); font-weight: 700; }
.tp-t { font-size: 34rpx; font-weight: 900; color: var(--gold); letter-spacing: 2rpx; }
.tp-s { font-size: 22rpx; color: var(--text-faint); margin-top: 4rpx; }

.tp-tip { margin: 24rpx 30rpx 0; padding: 18rpx 24rpx; }
.tp-tip-t { font-size: 22rpx; color: var(--text-dim); line-height: 1.6; }

.tp-list { padding: 24rpx 30rpx; display: flex; flex-direction: column; gap: 20rpx; }
.tp-card { display: flex; align-items: center; gap: 24rpx; padding: 20rpx 24rpx; border: 2rpx solid var(--line); }
.tp-using { border-color: var(--gold); box-shadow: 0 0 24rpx var(--gold-faint); }

/* ---------- 迷你场景预览 ---------- */
.tp-scene { width: 150rpx; height: 104rpx; border-radius: 14rpx; overflow: hidden; flex-shrink: 0;
  border: 2rpx solid var(--line); box-shadow: inset 0 0 20rpx rgba(0, 0, 0, 0.25); }
.tp-sky { position: relative; width: 100%; height: 100%; }
/* 天体：右上大圆（太阳/月亮） */
.tp-orb { position: absolute; top: 14rpx; width: 34rpx; height: 34rpx; border-radius: 50%;
  box-shadow: 0 0 16rpx currentColor; opacity: 0.95; }
/* 星点：三颗不同位置的小星 */
.tp-dot { position: absolute; border-radius: 50%; }
.tp-d1 { top: 12rpx; left: 22rpx; width: 6rpx; height: 6rpx; opacity: 0.9; }
.tp-d2 { top: 30rpx; left: 48rpx; width: 5rpx; height: 5rpx; opacity: 0.7; }
.tp-d3 { top: 52rpx; left: 14rpx; width: 4rpx; height: 4rpx; opacity: 0.6; }
/* 地表剪影：底部条 + 圆形山丘 */
.tp-ground { position: absolute; left: 0; right: 0; bottom: 0; height: 30rpx; }
.tp-hill { position: absolute; bottom: 16rpx; right: -20rpx; width: 110rpx; height: 44rpx; border-radius: 50%; }

.tp-n { font-size: 30rpx; font-weight: 800; color: var(--text); margin-right: 12rpx; }
.tp-en { font-size: 16rpx; color: var(--text-faint); }
.tp-d { font-size: 22rpx; color: var(--text-dim); margin-top: 6rpx; line-height: 1.5; }

.tp-state { flex-shrink: 0; }
.tp-st { font-size: 22rpx; padding: 8rpx 16rpx; border-radius: 8rpx; white-space: nowrap; }
.tp-on { color: var(--gold); border: 2rpx solid var(--gold); font-weight: 800; }
.tp-ok { color: var(--text-dim); border: 2rpx solid var(--line); }
.tp-lock { color: #FFFFFF; background: linear-gradient(135deg, #C8A84B, #A8790A); font-weight: 700; }

.tp-note { padding: 10rpx 30rpx 40rpx; text-align: center; }
.tp-note text { font-size: 20rpx; color: var(--text-faint); }

.tp-card-hover { opacity: 0.82; transform: scale(0.985); transition: all 0.08s; }
