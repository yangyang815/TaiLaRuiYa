/* 种子目录（种植种子） */
.seeds-root { min-height: 100vh; padding: 0 24rpx 40rpx; box-sizing: border-box; }

/* 顶部导航 */
.nav { display: flex; align-items: center; height: 88rpx; margin-bottom: 12rpx; }
.back { width: 64rpx; height: 64rpx; line-height: 60rpx; text-align: center;
  font-size: 44rpx; color: var(--text); border: 2rpx solid var(--line);
  border-radius: 14rpx; background: var(--card); }
.nav-t { flex: 1; text-align: center; font-size: 32rpx; font-weight: 800; color: var(--text); }
.nav-ph { width: 64rpx; }

/* 头部 */
.hero { display: flex; align-items: center; padding: 20rpx 24rpx; margin-bottom: 20rpx;
  border: 2rpx solid rgba(124, 232, 124, 0.4); border-radius: 20rpx;
  background: linear-gradient(120deg, rgba(124, 232, 124, 0.14), rgba(255, 215, 0, 0.1)); }
.hero-art { margin-right: 24rpx; }
.hero-t { font-size: 26rpx; color: #A9F5A9; letter-spacing: 4rpx; }
.hero-s { font-size: 24rpx; color: var(--text); margin-top: 6rpx; }
.hero-stat { font-size: 20rpx; color: var(--text-dim); margin-top: 8rpx; }
.floaty { animation: floaty 3s ease-in-out infinite; }
@keyframes floaty { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10rpx); } }

/* 分类 */
.cat-scroll { white-space: nowrap; margin-bottom: 20rpx; }
.cat-scroll .chip { display: inline-block; margin-right: 14rpx; }

/* 卡片列表 */
.sec-list { display: flex; flex-direction: column; }
.s-card { padding: 22rpx; margin-bottom: 18rpx; }
.sc-top { display: flex; align-items: center; }
.sc-art { margin-right: 20rpx; flex-shrink: 0; }
.sc-name-row { align-items: center; }
.sc-title { font-size: 30rpx; font-weight: 800; color: var(--text); line-height: 1.4; }
.tag-herb { color: #A9F5A9; background: rgba(60, 200, 90, 0.12); margin-left: 12rpx; }
.tag-grass { color: #FFD86B; background: rgba(255, 215, 0, 0.12); margin-left: 12rpx; }
.sc-meta { margin-top: 12rpx; align-items: center; flex-wrap: wrap; }
.bloom-chip { display: flex; align-items: center; border: 2rpx solid rgba(255, 143, 208, 0.45);
  border-radius: 10rpx; padding: 4rpx 12rpx; margin-right: 12rpx; }
.bloom-ico { font-size: 18rpx; color: #FF8FD0; margin-right: 6rpx; }
.bloom-t { font-size: 20rpx; color: #FF8FD0; }
.found-chip { border: 2rpx solid var(--line); border-radius: 10rpx; padding: 4rpx 12rpx; }
.found-t { font-size: 20rpx; color: var(--text-dim); }
.sc-foot { display: flex; justify-content: space-between; align-items: center;
  margin-top: 14rpx; padding-top: 14rpx; border-top: 2rpx dashed var(--line); }
.sc-potions { font-size: 20rpx; color: var(--text-dim); }
.sc-go { font-size: 20rpx; color: #A9F5A9; }

/* 详情弹窗 */
.mask { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.6); z-index: 60; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 61;
  max-height: 82vh; display: flex; flex-direction: column;
  background: var(--bg); border-top: 2rpx solid var(--line);
  border-radius: 28rpx 28rpx 0 0; padding: 12rpx 24rpx 0; box-sizing: border-box; }
.sheet-handle { width: 72rpx; height: 8rpx; border-radius: 4rpx;
  background: var(--line); margin: 8rpx auto 14rpx; }
.sh-head { display: flex; align-items: center; padding-bottom: 18rpx;
  border-bottom: 2rpx solid var(--line); }
.sh-art { margin-right: 22rpx; flex-shrink: 0; filter: drop-shadow(0 0 16rpx rgba(124, 232, 124, 0.35)); }
.sh-title { font-size: 32rpx; font-weight: 800; color: var(--text); line-height: 1.4; }
.sh-en { font-size: 18rpx; color: var(--text-dim); margin-left: 12rpx; letter-spacing: 2rpx; }
.sh-body { flex: 1; overflow: hidden; max-height: calc(82vh - 240rpx); }
.sh-intro { display: block; font-size: 24rpx; color: var(--text-dim); line-height: 1.7;
  padding: 18rpx 0 6rpx; }
.sh-pad { height: 40rpx; }

/* 信息卡（开花/获取） */
.info-grid { display: flex; margin-top: 14rpx; }
.info-cell { flex: 1; padding: 16rpx 18rpx; box-sizing: border-box; }
.info-cell:first-child { margin-right: 14rpx; }
.ic-label { font-size: 18rpx; color: #A9F5A9; letter-spacing: 2rpx; }
.ic-val { display: block; font-size: 26rpx; font-weight: 800; color: var(--text); margin-top: 8rpx; }
.ic-detail { display: block; font-size: 21rpx; color: var(--text-dim); line-height: 1.65; margin-top: 8rpx; }

/* 关联药水 */
.potion-chips { display: flex; flex-wrap: wrap; }
.p-chip { font-size: 21rpx; color: #FF8FD0; border: 2rpx solid rgba(255, 143, 208, 0.45);
  border-radius: 10rpx; padding: 6rpx 16rpx; margin: 0 12rpx 12rpx 0;
  background: rgba(255, 143, 208, 0.08); }

/* 种植知识 */
.fact { padding: 16rpx 20rpx; margin: 12rpx 0; }
.f-head { display: flex; align-items: flex-start; }
.f-i { width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; flex-shrink: 0;
  font-size: 20rpx; color: #A9F5A9; border: 2rpx solid rgba(124, 232, 124, 0.5);
  border-radius: 10rpx; margin-right: 16rpx; }
.f-t2 { font-size: 24rpx; color: var(--text); line-height: 1.7; flex: 1; }

/* 底部 */
.foot { text-align: center; padding: 30rpx 0 10rpx; }
.foot-t { font-size: 20rpx; color: var(--text-dim); letter-spacing: 4rpx; }
