/* 职业资料库 */
.cl-root { padding: 0 26rpx 60rpx; }

/* 职业路线联动入口 */
.path-link { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 24rpx; margin-bottom: 20rpx;
  border: 2rpx solid rgba(255, 215, 0, 0.4);
  background: linear-gradient(150deg, rgba(255, 215, 0, 0.10), rgba(26, 14, 46, 0.3)); }
.path-link:active { transform: scale(0.98); }
.pl-icon { font-size: 48rpx; }
.pl-t { font-size: 27rpx; font-weight: 800; color: #FFD700; }
.pl-s { font-size: 21rpx; color: var(--sub, #8a8a94); margin-top: 6rpx; }
.pl-arrow { font-size: 36rpx; color: #FFD700; font-weight: 700; }

/* 导航 */
.nav { display: flex; align-items: center; padding: 16rpx 0 12rpx; }
.nav-t { font-size: 36rpx; font-weight: 800; color: var(--text); flex: 1; text-align: center; }
.back { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; color: var(--gold, #FFD700); font-weight: 700; }
.nav-ph { width: 64rpx; }

/* 筛选行 */
.filter-row { gap: 14rpx; margin-bottom: 18rpx; flex-wrap: nowrap; }
.filter-row.wrap { flex-wrap: wrap; }
.f-chip { display: flex; align-items: center; justify-content: center; gap: 8rpx;
  padding: 14rpx 24rpx; border-radius: 16rpx; background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid rgba(255, 255, 255, 0.08); flex-shrink: 0; }
.f-chip.sm { padding: 10rpx 22rpx; }
.f-chip.on { background: rgba(255, 215, 0, 0.14); border-color: rgba(255, 215, 0, 0.5); }
.f-chip-icon { font-size: 24rpx; }
.f-chip-n { font-size: 24rpx; font-weight: 700; color: var(--sub, #8a8a94); }
.f-chip.on .f-chip-n { color: #FFD700; }

/* 文章卡 */
.art { display: flex; align-items: center; padding: 22rpx 24rpx; margin-bottom: 18rpx; gap: 20rpx; }
.art-cover { width: 104rpx; height: 104rpx; border-radius: 16rpx; background: rgba(0, 0, 0, 0.28);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.art-title-row { gap: 10rpx; }
.art-flag { font-size: 24rpx; }
.art-title { font-size: 27rpx; font-weight: 700; color: var(--text); line-height: 1.4; }
.art-summary { margin-top: 8rpx; font-size: 22rpx; color: var(--sub, #8a8a94); line-height: 1.5;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.art-meta-row { margin-top: 10rpx; }
.art-cls { font-size: 20rpx; color: #7fd0ff; }
.art-time { margin-left: auto; font-size: 20rpx; color: var(--sub, #8a8a94); }

/* 空状态 */
.empty { padding: 80rpx 40rpx; display: flex; flex-direction: column; align-items: center; }
.empty-t { font-size: 28rpx; font-weight: 700; color: var(--text); }
.empty-s { font-size: 22rpx; color: var(--sub, #8a8a94); margin-top: 12rpx; }
