/* 反馈页 */
.fb-root { min-height: 100vh; padding-bottom: 60rpx; box-sizing: border-box; }

/* 导航（对齐 acq 页） */
.nav { display: flex; align-items: center; padding-left: 24rpx; }
.back { width: 64rpx; height: 64rpx; line-height: 60rpx; text-align: center;
  font-size: 44rpx; color: var(--text); border-radius: 50%;
  background: rgba(255, 255, 255, 0.06); }
.nav-t { flex: 1; text-align: center; font-size: 32rpx; font-weight: 600; color: var(--text); }
.nav-ph { width: 64rpx; }

/* 区块 */
.sec { margin: 28rpx 30rpx 0; }
.sec-t { display: block; font-size: 24rpx; color: var(--text-dim); margin-bottom: 14rpx; }

/* 类型 chips */
.type-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.type-chip { display: flex; align-items: center; gap: 8rpx;
  padding: 14rpx 26rpx; border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06); border: 2rpx solid var(--line); }
.type-chip.on { background: var(--gold-faint); border-color: var(--gold); }
.tc-ico { font-size: 26rpx; }
.tc-n { font-size: 26rpx; color: var(--text); }
.type-chip.on .tc-n { color: var(--gold); font-weight: 600; }

/* 纠错上下文卡片 */
.ctx-card { margin: 28rpx 30rpx 0; padding: 20rpx 24rpx; border-radius: 16rpx;
  background: rgba(255, 215, 0, 0.08); border: 2rpx solid var(--gold-soft);
  display: flex; flex-direction: column; gap: 8rpx; }
.ctx-t { font-size: 24rpx; color: var(--gold); font-weight: 600; }
.ctx-name { font-size: 28rpx; color: var(--text); font-weight: 600; }
.ctx-text { font-size: 22rpx; color: var(--text-dim); line-height: 1.5;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }

/* 内容输入 */
.input-box { position: relative; border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06); border: 2rpx solid var(--line); padding: 20rpx; }
.ta { width: 100%; height: 220rpx; font-size: 28rpx; color: var(--text); line-height: 1.6; }
.ta-ph { color: var(--text-faint); }
.len { position: absolute; right: 20rpx; bottom: 14rpx; font-size: 20rpx; color: var(--text-faint); }

/* 截图 */
.shot-row { display: flex; }
.shot { position: relative; width: 160rpx; height: 160rpx; border-radius: 12rpx; overflow: hidden;
  border: 2rpx solid var(--line); }
.shot-img { width: 100%; height: 100%; }
.shot-del { position: absolute; top: 0; right: 0; width: 44rpx; height: 44rpx;
  line-height: 40rpx; text-align: center; font-size: 30rpx; color: #fff;
  background: rgba(0, 0, 0, 0.55); border-radius: 0 0 0 12rpx; }
.shot-add { width: 160rpx; height: 160rpx; border-radius: 12rpx;
  border: 2rpx dashed var(--line); display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; color: var(--text-faint); }

/* 提交 */
.fb-submit { margin: 40rpx 30rpx 0; text-align: center; }
.fb-submit.dis { opacity: 0.5; pointer-events: none; }
.fb-hint { display: block; margin: 18rpx 30rpx 0; text-align: center;
  font-size: 20rpx; color: var(--text-faint); }
