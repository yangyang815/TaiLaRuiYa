/* 首页：星空 + 昼夜 */
.home-root { position: relative; overflow: hidden; padding-bottom: 40rpx; }
.sky { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
.sky.day-glow {
  background:
    radial-gradient(60% 30% at 80% -5%, rgba(255, 215, 0, 0.16), transparent 70%),
    radial-gradient(50% 30% at 10% 0%, rgba(76, 175, 80, 0.1), transparent 70%);
}
.home-root.night {
  background:
    radial-gradient(70% 26% at 85% -4%, rgba(255, 215, 0, 0.1), transparent 70%),
    radial-gradient(60% 30% at 8% 2%, rgba(94, 60, 154, 0.28), transparent 72%),
    #120925;
}
.home-root.day {
  background:
    radial-gradient(70% 30% at 85% -6%, rgba(255, 233, 138, 0.35), transparent 70%),
    linear-gradient(180deg, #3A2C58 0%, #1A0E2E 40%, #120925 100%);
}
.home-root > nav, .home-root > .nav { position: relative; z-index: 2; }

/* 顶部导航 */
.nav { position: relative; z-index: 5; padding: 16rpx 30rpx 12rpx; }
.nav-in { display: flex; align-items: center; justify-content: space-between; }
.logo { display: flex; align-items: center; }
.logo-t { font-size: 20rpx; color: var(--gold); text-shadow: 0 0 14rpx rgba(255, 215, 0, 0.5); }
.logo-s { font-size: 20rpx; color: var(--text-dim); margin-top: 4rpx; letter-spacing: 2rpx; }
.clock { font-size: 26rpx; color: var(--text-dim); font-weight: 700; letter-spacing: 2rpx; }

/* 顶部第二行：问候语（左） + 时间/日期（右）
   独占整行宽度，彻底摆脱第一行 Logo/按钮的横向挤压——
   之前三者挤同一行，真机上时间行被压缩导致"看不见" */
.nav-sub { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; }
.hello { font-size: 24rpx; color: var(--text); font-weight: 800; letter-spacing: 1rpx;
  text-shadow: 0 0 12rpx rgba(255, 215, 0, 0.25);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 16rpx; }
/* 时间行：金色时钟 + 日期，永不收缩 */
.clock-line { display: flex; align-items: center; flex-shrink: 0; white-space: nowrap; }
.clock-line .clock {
  font-size: 34rpx; color: var(--gold); font-weight: 800; letter-spacing: 2rpx;
  text-shadow: 0 0 14rpx rgba(255, 215, 0, 0.5);
}
.clock-date { font-size: 19rpx; color: var(--text-dim); margin-left: 10rpx; letter-spacing: 1rpx; }
.quick-btns { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.q-btn {
  position: relative; width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 14rpx; flex-shrink: 0;
  background: rgba(255, 255, 255, 0.07); border: 2rpx solid var(--line);
  box-shadow: inset 0 0 14rpx rgba(0, 0, 0, 0.3);
}
.page-root.theme-light .q-btn { background: rgba(120, 96, 40, 0.08); }
.q-ico { font-size: 30rpx; line-height: 1; }
/* 消息未读红点 */
.q-dot {
  position: absolute; top: 6rpx; right: 6rpx;
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: #E85555; border: 2rpx solid #1A0E2E;
  box-shadow: 0 0 10rpx rgba(232, 85, 85, 0.8);
}
/* 成就角标：已解锁数 */
.q-badge {
  position: absolute; top: -10rpx; right: -10rpx;
  min-width: 30rpx; height: 30rpx; padding: 0 8rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 17rpx; font-weight: 800; color: #4A2B00;
  background: linear-gradient(180deg, #FFE55C, #E5B800);
  border: 2rpx solid #FFF0B0; border-radius: 999rpx;
  box-shadow: 0 0 12rpx rgba(255, 215, 0, 0.5);
}

/* 搜索行 */
.search-row { display: flex; align-items: center; padding: 12rpx 30rpx 4rpx; position: relative; z-index: 5; }
.search-bar {
  flex: 1; display: flex; align-items: center;
  padding: 14rpx 24rpx; border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid var(--line);
}
.s-ico { font-size: 24rpx; margin-right: 12rpx; }
.s-ph { font-size: 24rpx; color: #C8B8A8; }
.s-input { flex: 1; font-size: 24rpx; color: var(--text); min-height: 34rpx; }
.s-clear { font-size: 24rpx; color: var(--text-faint); padding: 0 4rpx 0 12rpx; }

/* 首页内联搜索面板（悬浮于内容之上） */
.search-panel {
  position: relative; z-index: 30; margin: 12rpx 30rpx 0;
  padding: 6rpx 22rpx 4rpx; max-height: 660rpx; overflow-y: auto;
}
.sp-label { font-size: 21rpx; color: var(--text-faint); font-weight: 800; letter-spacing: 2rpx;
  padding: 14rpx 4rpx 6rpx; }
.sp-clear { color: #4CE0E0; margin-left: 14rpx; font-weight: 700; }
.sp-row { display: flex; align-items: center; padding: 12rpx 4rpx; }
.sp-row + .sp-row { border-top: 2rpx solid var(--line); }
.sp-art { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center;
  background: rgba(0, 0, 0, 0.25); border-radius: 8rpx; margin-right: 16rpx; flex-shrink: 0; }
.sp-diamond { width: 12rpx; height: 12rpx; background: var(--gold); transform: rotate(45deg);
  margin: 0 22rpx; flex-shrink: 0; }
.sp-name { font-size: 25rpx; color: var(--text); font-weight: 700; }
.sp-tag { font-size: 19rpx; color: var(--gold); border: 1rpx solid var(--gold-faint);
  border-radius: 6rpx; padding: 2rpx 10rpx; flex-shrink: 0; }
.sp-go { color: var(--gold); font-size: 28rpx; margin-left: 14rpx; flex-shrink: 0; }
.sp-none { padding: 20rpx 4rpx; font-size: 24rpx; color: var(--text-faint); text-align: center; }
.sp-more { margin-top: 8rpx; padding: 16rpx 4rpx 12rpx; text-align: center;
  font-size: 23rpx; color: #4CE0E0; font-weight: 700; border-top: 2rpx solid var(--line); }
.sp-chips { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 4rpx 4rpx 12rpx; }
.sp-chip { font-size: 22rpx; color: var(--text-dim); padding: 8rpx 22rpx;
  border-radius: 999rpx; background: var(--card); border: 2rpx solid var(--line); }
.sp-chip.hot { color: var(--gold); border-color: var(--gold-faint); background: rgba(255, 215, 0, 0.07); }

/* 海报入口按钮 */
.poster-fab {
  width: 68rpx; height: 68rpx; margin-left: 16rpx; flex-shrink: 0;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 800; color: #3A2400;
  background: linear-gradient(180deg, #FFE55C, #E5B800);
  border: 2rpx solid #FFF0B0;
  box-shadow: 0 6rpx 20rpx rgba(255, 200, 60, 0.35);
}

/* 轮播 Banner */
.banner { position: relative; z-index: 2; margin: 12rpx 30rpx 0; }
.banner-swiper { height: 176rpx; }
.slide {
  display: flex; align-items: center; height: 176rpx;
  padding: 0 26rpx; box-sizing: border-box; overflow: hidden;
}
/* 禁用 tappable 的 transform 过渡：与 swiper 切页位移叠加会导致轮播卡顿 */
.slide.tappable { transition: none; }
.sl-ico { font-size: 44rpx; margin-right: 18rpx; flex-shrink: 0; }
.sl-tag { font-size: 20rpx; color: var(--gold); font-weight: 800; letter-spacing: 2rpx;
  text-shadow: 0 0 10rpx rgba(255, 215, 0, 0.35); }
.sl-title { font-size: 30rpx; font-weight: 900; color: var(--text); margin-top: 4rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sl-sub { font-size: 22rpx; color: var(--text-dim); margin-top: 6rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sl-art { flex-shrink: 0; margin-left: 12rpx; filter: drop-shadow(0 0 16rpx rgba(255, 215, 0, 0.28)); }
/* 圆点指示器 */
.banner-dots { display: flex; justify-content: center; gap: 12rpx; margin-top: 14rpx; }
.dot { width: 12rpx; height: 12rpx; border-radius: 6rpx; background: rgba(224, 214, 200, 0.28);
  transition: all 0.3s ease; }
.dot.on { width: 34rpx; background: linear-gradient(90deg, #FFE55C, #E5B800);
  box-shadow: 0 0 10rpx rgba(255, 215, 0, 0.55); }

/* 最近浏览（横向滚动）——右内边距不计入滚动宽度，末元素 margin 代替 */
.recent-scroll { white-space: nowrap; padding: 0 0 0 30rpx; position: relative; z-index: 2; box-sizing: border-box; }
.r-chip {
  display: inline-flex; align-items: center; padding: 12rpx 20rpx 12rpx 14rpx;
  margin-right: 16rpx; vertical-align: middle;
}
.r-chip:last-child { margin-right: 30rpx; }
.r-ico { font-size: 26rpx; margin-right: 10rpx; flex-shrink: 0; }
.r-art { width: 56rpx; height: 56rpx; border-radius: 10rpx; background: rgba(0, 0, 0, 0.25);
  display: flex; align-items: center; justify-content: center; margin-right: 14rpx; flex-shrink: 0; }
.r-name { font-size: 24rpx; font-weight: 700; color: var(--text); max-width: 150rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.r-label { font-size: 19rpx; color: var(--text-faint); margin-top: 2rpx; }
.recent-more { margin-left: auto; font-size: 22rpx; color: #4CE0E0; font-weight: 700; flex-shrink: 0; }
.recent-empty { margin: 4rpx 30rpx 0; padding: 22rpx; font-size: 23rpx; color: var(--text-faint);
  text-align: center; border: 2rpx dashed var(--line); border-radius: 12rpx;
  position: relative; z-index: 2; }

/* 宫格 */
.grid { display: flex; flex-wrap: wrap; padding: 0 30rpx; gap: 20rpx; position: relative; z-index: 2; }
.g-cell {
  width: calc((100% - 60rpx) / 4);
  display: flex; flex-direction: column; align-items: center;
  padding: 24rpx 0 18rpx;
  position: relative;
  transition: transform 0.16s ease-out;
}
/* 最近使用：金色边框 + 微光 */
.g-cell.recent { border-color: rgba(255, 215, 0, 0.6); box-shadow: 0 0 16rpx rgba(255, 215, 0, 0.22); }
.g-star { position: absolute; top: 8rpx; right: 12rpx; font-size: 20rpx; color: var(--gold);
  text-shadow: 0 0 8rpx rgba(255, 215, 0, 0.6); }
/* 拖动中：浮起置顶、禁用过渡保证跟手 */
.g-cell.dragging { z-index: 10; transition: none; opacity: 0.92; will-change: transform;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.55); border-color: rgba(76, 224, 224, 0.8); }
/* 松手落位瞬间：全部卡片禁用过渡，直接归位（避免让位卡片反向滑一格） */
.grid.snapping .g-cell { transition: none; }
.g-art { height: 88rpx; display: flex; align-items: center; margin-bottom: 12rpx; }
.g-name { font-size: 24rpx; color: var(--text); font-weight: 700; }

/* 展开 / 收起按钮 */
.grid-more { display: flex; justify-content: center; margin: 20rpx 30rpx 0; position: relative; z-index: 2; }
.gm-t { font-size: 23rpx; color: var(--text-dim); font-weight: 700; letter-spacing: 2rpx;
  padding: 12rpx 44rpx; border: 2rpx solid var(--line); border-radius: 999rpx; background: var(--card); }
.grid-tools { display: flex; justify-content: center; align-items: center; gap: 26rpx; margin: 18rpx 30rpx 0; position: relative; z-index: 2; }
.gt-hint { font-size: 20rpx; color: var(--text-dim); opacity: 0.85; }
.gt-reset { font-size: 21rpx; color: #4CE0E0; font-weight: 700;
  padding: 6rpx 18rpx; border: 2rpx solid rgba(76, 224, 224, 0.4); border-radius: 10rpx; }

/* 今日热门（列表行） */
.hot-list { margin: 4rpx 30rpx 10rpx; padding: 6rpx 24rpx; position: relative; z-index: 2; }
.hot-row { display: flex; align-items: center; padding: 16rpx 0; }
.hot-row + .hot-row { border-top: 2rpx solid var(--line); }
.h-no { font-size: 22rpx; color: var(--gold); font-weight: 900; width: 88rpx; flex-shrink: 0;
  text-shadow: 0 0 8rpx rgba(255, 215, 0, 0.4); }
.h-art { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center;
  margin-right: 18rpx; flex-shrink: 0; }
.h-name { font-size: 27rpx; font-weight: 700; color: var(--text); overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap; }
.h-tag { font-size: 22rpx; color: #8A7A6A; margin-left: 12rpx; flex-shrink: 0; }
.h-arrow { color: var(--gold); font-size: 30rpx; margin-left: 8rpx; flex-shrink: 0; }

/* 热门"更多"入口（标题行最右，.more 已占 auto 边距） */
.hot-more { font-size: 22rpx; color: #4CE0E0; font-weight: 700; margin-left: 20rpx; flex-shrink: 0; }

/* 热门分类切换 chips */
.hot-cats { display: flex; align-items: center; gap: 16rpx; margin: 6rpx 30rpx 14rpx; position: relative; z-index: 2; }
.hot-cat { font-size: 22rpx; font-weight: 700; color: var(--text-dim); padding: 8rpx 26rpx;
  border: 2rpx solid var(--line); border-radius: 999rpx; background: var(--card); transition: all 0.2s ease; }
.hot-cat.on { color: #1A1410; background: linear-gradient(120deg, #FFD700, #FFA940);
  border-color: rgba(255, 215, 0, 0.6); box-shadow: 0 0 14rpx rgba(255, 215, 0, 0.35); }

/* 热度趋势 */
.h-trend { font-size: 22rpx; font-weight: 900; margin-left: 12rpx; flex-shrink: 0; letter-spacing: 1rpx; }
.h-trend.t-up { color: #FF6B4A; text-shadow: 0 0 10rpx rgba(255, 107, 74, 0.5); }
.h-trend.t-down { color: #4CA6FF; }
.h-trend.t-flat { color: var(--text-faint); }
.h-trend.t-new { color: #7CE87C; font-size: 19rpx; }

/* 底部 */
.home-foot { display: flex; flex-direction: column; align-items: center; margin-top: 46rpx; position: relative; z-index: 2; }
.foot-t { font-size: 16rpx; color: var(--text-faint); letter-spacing: 3rpx; }
.foot-s { font-size: 20rpx; color: var(--text-faint); margin-top: 8rpx; opacity: 0.8; }

/* 白天主题微调 */
.page-root.day .b-title { color: #FFFFFF; }

/* 新手指南入口（紧随冒险手册标题下方，唯一横条，与宫格对齐） */
.se-art { margin-right: 22rpx; flex-shrink: 0; filter: drop-shadow(0 0 14rpx rgba(124, 232, 124, 0.45)); }
.floaty { animation: floaty 3s ease-in-out infinite; }
@keyframes floaty { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8rpx); } }
.se-title-row { align-items: center; }
.se-sub { font-size: 21rpx; color: var(--text-dim); line-height: 1.6; margin-top: 8rpx; }
.feature-entry { display: flex; align-items: center; padding: 22rpx 24rpx; margin: 0 30rpx 20rpx;
  border-radius: 20rpx; }
.feature-entry.entry-guide { border: 2rpx solid rgba(60, 200, 90, 0.45);
  background: linear-gradient(120deg, rgba(60, 200, 90, 0.22), rgba(255, 215, 0, 0.08)),
    radial-gradient(80% 120% at 90% 10%, rgba(124, 232, 124, 0.1), transparent 60%); }
.fe-title { font-size: 30rpx; font-weight: 800; }
.ft-guide { color: #A9F5A9; }
.fe-badge { font-size: 18rpx; border-radius: 8rpx; padding: 2rpx 10rpx; margin-left: 14rpx; letter-spacing: 2rpx; }
.fb-guide { color: #A9F5A9; border: 2rpx solid rgba(124, 232, 124, 0.45); }
.fe-go { font-size: 40rpx; margin-left: 12rpx; }
.fg-guide { color: #7CE87C; }

/* 白天模式（用户主题）覆盖昼夜深色背景 */
.page-root.theme-light.home-root,
.page-root.theme-light.home-root.day,
.page-root.theme-light.home-root.night {
  background:
    radial-gradient(70% 26% at 85% -4%, rgba(255, 233, 138, 0.45), transparent 70%),
    radial-gradient(60% 30% at 8% 2%, rgba(76, 175, 80, 0.08), transparent 72%),
    var(--bg-deep);
}
.page-root.theme-light .search-pill { background: rgba(255, 255, 255, 0.75); }

/* 白天模式：新手指南文字加深（浅底上高对比） */
.page-root.theme-light .ft-guide { color: #1F7A24; }
.page-root.theme-light .fb-guide { color: #1F7A24; border-color: rgba(31, 122, 36, 0.55); }
.page-root.theme-light .fg-guide { color: #1F7A24; }
/* 白天模式：入口底色加重，衬托深色文字 */
.page-root.theme-light .feature-entry.entry-guide {
  background: linear-gradient(120deg, rgba(60, 200, 90, 0.16), rgba(255, 215, 0, 0.10)),
    radial-gradient(80% 120% at 90% 10%, rgba(124, 232, 124, 0.12), transparent 60%),
    rgba(255, 252, 240, 0.6); }
.sp-emoji { font-size: 40rpx; line-height: 1.2; margin-right: 16rpx; flex-shrink: 0; }
