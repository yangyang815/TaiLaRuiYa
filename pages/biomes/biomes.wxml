<view class="page-root {{themeClass}} biomes-root">

  <!-- 顶部：返回 + 标题（避让胶囊） -->
  <view class="nav" style="padding-top:{{statusBarHeight}}px;padding-right:{{capsuleRight}}px;">
    <view class="back tappable" bindtap="back">‹</view>
    <text class="nav-t">生物群系</text>
    <view class="nav-ph" />
  </view>

  <!-- 头部统计 -->
  <view class="hero">
    <view class="hero-art floaty"><pixel-icon art-id="jungle_spore" size="120" /></view>
    <view class="col flex-1">
      <text class="hero-t px">BIOME ATLAS</text>
      <text class="hero-s">从森林到地狱 · 看懂整张地图</text>
      <text class="hero-stat px">{{total}} 个群系 · {{factTotal}} 条情报</text>
    </view>
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="cat-scroll" scroll-x enable-flex enhanced show-scrollbar="{{false}}">
    <view class="chip {{cat === item.k ? 'on' : ''}}" wx:for="{{cats}}" wx:key="k"
      bindtap="onCat" data-k="{{item.k}}">{{item.n}}</view>
  </scroll-view>

  <!-- 群系卡片列表 -->
  <view class="sec-list">
    <view class="s-card card tappable" wx:for="{{list}}" wx:key="id"
      bindtap="onCard" data-id="{{item.id}}">
      <view class="sc-top">
        <view class="sc-art"><pixel-icon art-id="{{item.art}}" size="96" /></view>
        <view class="col flex-1">
          <view class="row sc-name-row">
            <text class="sc-title">{{item.name}}</text>
            <text class="sc-en px">{{item.en}}</text>
          </view>
          <view class="row sc-tags">
            <text class="tag tag-biome">{{item.catName}}</text>
            <view class="row sc-danger">
              <view class="dot {{d.on ? 'on d' + item.danger : ''}}" wx:for="{{item.dots}}" wx:for-item="d" wx:key="i" />
              <text class="sc-dn px">{{item.dangerName}}</text>
            </view>
          </view>
          <text class="sc-layer">{{item.layer}}</text>
        </view>
      </view>
      <text class="sc-intro">{{item.intro}}</text>
      <view class="sc-foot">
        <text class="sc-count px">{{item.count}} 条情报</text>
        <text class="sc-go px">探索 ›</text>
      </view>
    </view>
  </view>

  <view class="foot safe-bottom">
    <text class="foot-t px">KNOW THE WORLD, BEAT THE WORLD</text>
  </view>

  <!-- 详情弹窗 -->
  <view class="mask" wx:if="{{sheet}}" bindtap="closeSheet" />
  <view class="sheet" wx:if="{{sheet}}" catchtap="noop">
    <view class="sheet-handle" bindtap="closeSheet" />
    <view class="sh-head">
      <view class="sh-art">
        <pixel-icon art-id="{{sheet.art}}" size="120" />
      </view>
      <view class="col flex-1">
        <view class="row sc-name-row">
          <text class="sh-title">{{sheet.name}}</text>
          <text class="sc-en px">{{sheet.en}}</text>
        </view>
        <view class="row sc-tags">
          <text class="tag tag-biome">{{sheet.catName}}</text>
          <view class="row sc-danger">
            <view class="dot {{d.on ? 'on d' + sheet.danger : ''}}" wx:for="{{sheet.dots}}" wx:for-item="d" wx:key="i" />
            <text class="sc-dn px">{{sheet.dangerName}}</text>
          </view>
        </view>
        <text class="sc-layer">{{sheet.layer}}</text>
      </view>
    </view>

    <scroll-view class="sh-body" scroll-y>
      <text class="sh-intro">{{sheet.intro}}</text>

      <view class="sec-title"><view class="diamond" /><text class="t">群系情报 · {{sheet.count}} 条</text></view>
      <view class="fact card" wx:for="{{sheet.facts}}" wx:key="t">
        <view class="f-head">
          <text class="f-i px">{{index + 1}}</text>
          <text class="f-t">{{item.t}}</text>
        </view>
        <text class="f-d">{{item.d}}</text>
      </view>

      <view class="sh-pad" />
    </scroll-view>
  </view>
</view>
