/* 合成页：向导对话 + 物品栏格子纹理 */
.craft-root {
  min-height: 100vh; padding-bottom: 60rpx; position: relative;
  background-image:
    linear-gradient(rgba(255, 215, 0, 0.05) 2rpx, transparent 2rpx),
    linear-gradient(90deg, rgba(255, 215, 0, 0.05) 2rpx, transparent 2rpx);
  background-size: 88rpx 88rpx;
  background-position: center top;
}

.head { padding: 16rpx 30rpx 0; position: relative; z-index: 5; }

/* 品牌区 */
.brand-row { display: flex; align-items: center; justify-content: space-between; padding: 4rpx 0 16rpx; }
.logo { display: flex; align-items: center; }
.logo-t { font-size: 22rpx; color: var(--gold); font-weight: 800; letter-spacing: 2rpx;
  text-shadow: 0 0 14rpx rgba(255, 215, 0, 0.5); }
.logo-s { font-size: 20rpx; color: var(--text-dim); margin-top: 4rpx; letter-spacing: 3rpx; }
.clock { font-size: 26rpx; color: var(--gold); font-weight: 700; letter-spacing: 2rpx; }

/* 全局搜索框 */
.search-row { display: flex; align-items: center; }
.search-bar { flex: 1; display: flex; align-items: center; border: 2rpx solid var(--line);
  background: rgba(255, 255, 255, 0.08); border-radius: 999rpx; padding: 12rpx 26rpx; }
.s-ico { font-size: 26rpx; margin-right: 14rpx; }
.s-input { flex: 1; font-size: 26rpx; color: var(--text); }
.s-clear { padding: 4rpx 8rpx; color: var(--text-faint); font-size: 24rpx; }
.sg-en { font-size: 16rpx; color: var(--text-faint); margin-top: 4rpx; }
.head-fade { height: 20rpx; margin: 16rpx -30rpx 0;
  background: linear-gradient(180deg, rgba(18, 9, 37, 0.9), rgba(18, 9, 37, 0)); }
.page-root.theme-light .head-fade { background: linear-gradient(180deg, rgba(231, 221, 198, 0.9), rgba(231, 221, 198, 0)); }

.guide { padding: 26rpx 26rpx 22rpx; }
.g-row { display: flex; align-items: center; }
.g-avatar { width: 84rpx; height: 84rpx; border-radius: 14rpx; background: rgba(0, 0, 0, 0.3);
  display: flex; align-items: center; justify-content: center; margin-right: 22rpx;
  border: 2rpx solid var(--gold-faint); flex-shrink: 0; }
.g-say { font-size: 26rpx; color: var(--gold); font-weight: 700; line-height: 1.6; }

/* 海报入口按钮 */
.poster-fab {
  width: 68rpx; height: 68rpx; margin-left: 16rpx; flex-shrink: 0;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 800; color: #3A2400;
  background: linear-gradient(180deg, #FFE55C, #E5B800);
  border: 2rpx solid #FFF0B0;
  box-shadow: 0 6rpx 20rpx rgba(255, 200, 60, 0.35);
}

.in-box { display: flex; align-items: center; margin-top: 20rpx; position: relative; }
.in-label { width: 128rpx; font-size: 24rpx; color: var(--text-dim); font-weight: 800; flex-shrink: 0; }
.ph { color: var(--text-faint); }
.s-clear { padding: 4rpx 10rpx; color: var(--text-faint); }

.switch-line { margin-top: 24rpx; }
.switch-tip { font-size: 20rpx; color: var(--text-faint); margin-left: 16rpx; flex: 1; line-height: 1.4; }

.suggest { position: relative; margin: 12rpx 0 0 128rpx; padding: 8rpx 0; z-index: 30; }
.sg-item { display: flex; align-items: center; padding: 10rpx 20rpx; }
.sg-art { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center;
  background: rgba(0, 0, 0, 0.25); border-radius: 8rpx; margin-right: 18rpx; flex-shrink: 0; }
.sg-name { flex: 1; font-size: 26rpx; color: var(--text); font-weight: 700; }
.sg-sub { font-size: 20rpx; color: var(--text-faint); margin-top: 4rpx; }
.sg-go { font-size: 18rpx; color: var(--gold); }

/* 配方筛选（分类 + 工作台） */
/* 横滑 scroll-view：右内边距不计入滚动宽度，留白改为末元素 margin（否则最后一块被裁掉） */
.f-scroll { white-space: nowrap; padding: 6rpx 0 0 30rpx; position: relative; z-index: 2; }
.f-chip { display: inline-block; padding: 10rpx 26rpx; margin-right: 14rpx;
  border: 2rpx solid var(--line); border-radius: 999rpx; background: var(--card);
  font-size: 23rpx; font-weight: 700; color: var(--text-dim);
  transition: all 0.2s ease; }
.f-chip:last-child { margin-right: 30rpx; }
.f-chip.on { color: #3A2400; background: linear-gradient(180deg, #FFE55C, #E5B800);
  border-color: #FFF0B0; box-shadow: 0 0 14rpx rgba(255, 215, 0, 0.4); }
.f-chip.st.on { background: linear-gradient(180deg, #7CE8D8, #29A896);
  border-color: rgba(124, 232, 216, 0.7); box-shadow: 0 0 14rpx rgba(76, 224, 224, 0.4); }
.fr-list { margin: 16rpx 30rpx 0; padding: 6rpx 20rpx; position: relative; z-index: 2;
  max-height: 720rpx; overflow-y: auto; }
.fr-row { display: flex; align-items: center; padding: 14rpx 4rpx; }
.fr-row + .fr-row { border-top: 2rpx solid var(--line); }
.fr-art { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center;
  background: rgba(0, 0, 0, 0.25); border-radius: 10rpx; margin-right: 18rpx; flex-shrink: 0; }
.fr-n { font-size: 25rpx; color: var(--text); font-weight: 700; }
.fr-s { font-size: 19rpx; color: var(--text-faint); margin-top: 4rpx; }
.fr-cat { font-size: 19rpx; color: #4CE0E0; border: 1rpx solid rgba(76, 224, 224, 0.35);
  border-radius: 6rpx; padding: 2rpx 10rpx; margin-right: 12rpx; flex-shrink: 0; }
.fr-go { font-size: 18rpx; color: var(--gold); flex-shrink: 0; }
.sg-none { display: flex; flex-direction: column; align-items: center; padding: 24rpx 20rpx 16rpx;
  margin: 12rpx 0 0 128rpx; background: rgba(0, 0, 0, 0.22); border: 2rpx dashed rgba(255, 215, 0, 0.25);
  border-radius: 12rpx; }
.sg-none-icon { font-size: 40rpx; margin-bottom: 8rpx; }
.sg-none-t { font-size: 26rpx; color: var(--text); font-weight: 700; }
.sg-none-d { font-size: 20rpx; color: var(--text-dim); margin-top: 8rpx; text-align: center; }

.chips { display: flex; flex-wrap: wrap; margin: 16rpx 0 0 128rpx; }
.have-chip { display: inline-flex; align-items: center; padding: 8rpx 18rpx; margin: 0 14rpx 14rpx 0;
  background: rgba(76, 175, 80, 0.16); border: 2rpx solid rgba(76, 175, 80, 0.5);
  border-radius: 999rpx; font-size: 22rpx; color: #7CD86A; }
.hc-x { margin-left: 10rpx; opacity: 0.7; }
.have-clear { font-size: 22rpx; color: var(--text-faint); padding: 8rpx 6rpx; }

/* 合成树 */
.sec-title { padding-left: 30rpx; padding-right: 30rpx; }
.tree { margin: 0 30rpx; padding: 10rpx 0; }

/* 目标物品卡 */
.target-card { position: relative; margin: 0 30rpx; padding: 30rpx 28rpx; overflow: hidden; }
.tc-glow { position: absolute; inset: -40rpx; pointer-events: none; }
.tc-row { display: flex; align-items: center; position: relative; }
.tc-art { width: 128rpx; height: 128rpx; border-radius: 16rpx; background: rgba(0, 0, 0, 0.3);
  display: flex; align-items: center; justify-content: center; margin-right: 24rpx; flex-shrink: 0;
  border: 2rpx solid var(--line); }
.tc-name { font-size: 34rpx; color: var(--text); font-weight: 900; }
.tc-fav { margin-left: 14rpx; font-size: 34rpx; color: var(--text-faint); padding: 4rpx 8rpx; }
.tc-fav.on { color: var(--gold); text-shadow: 0 0 12rpx rgba(255, 215, 0, 0.6); }
.tc-en { font-size: 18rpx; color: var(--text-faint); margin-top: 6rpx; letter-spacing: 1rpx; }
.tc-station { font-size: 22rpx; color: var(--gold); margin-top: 10rpx; }
.tc-stats { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 22rpx; position: relative; }
.tc-stat { display: flex; align-items: center; background: rgba(0, 0, 0, 0.25);
  border: 2rpx solid var(--line); border-radius: 10rpx; padding: 8rpx 16rpx; }
.tc-k { font-size: 20rpx; color: var(--text-dim); margin-right: 10rpx; }
.tc-v { font-size: 22rpx; color: var(--gold); font-weight: 700; }

/* 一级材料行 */
.mats { margin: 0 30rpx; padding: 8rpx 0; }
.mat-row { display: flex; align-items: center; padding: 14rpx 20rpx; border-radius: 12rpx;
  transition: background 0.2s; }
.mat-row:active { background: rgba(255, 215, 0, 0.06); }
.mat-row.own { background: rgba(76, 175, 80, 0.07); }
.mat-art { width: 72rpx; height: 72rpx; border-radius: 12rpx; background: rgba(0, 0, 0, 0.25);
  display: flex; align-items: center; justify-content: center; margin-right: 18rpx; flex-shrink: 0; }
.mat-name { font-size: 26rpx; color: var(--text); font-weight: 700; max-width: 240rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mat-count { font-size: 20rpx; color: var(--gold); margin-left: 10rpx; }
.mat-craft { font-size: 16rpx; color: #8EC8FF; border: 1rpx solid rgba(142, 200, 255, 0.4);
  border-radius: 6rpx; padding: 0 8rpx; margin-left: 12rpx; }
.mat-status { font-size: 22rpx; font-weight: 700; flex-shrink: 0; margin-left: 12rpx; }
.mat-status.ok { color: #7CD86A; }
.mat-status.no { color: #E85555; }
.mat-get { font-size: 20rpx; color: var(--gold); border: 2rpx solid var(--gold-faint);
  border-radius: 999rpx; padding: 6rpx 18rpx; margin-left: 12rpx; flex-shrink: 0; }

.t-row { display: flex; align-items: center; padding: 16rpx 20rpx 16rpx 20rpx !important;
  border-radius: 12rpx; transition: background 0.2s; }
.t-row:active { background: rgba(255, 215, 0, 0.06); }
.t-row.have { background: rgba(76, 175, 80, 0.07); }
.t-row.lack { background: rgba(232, 85, 85, 0.07); }
.t-fold { width: 40rpx; height: 40rpx; border: 2rpx solid var(--gold-faint); border-radius: 8rpx;
  display: flex; align-items: center; justify-content: center; color: var(--gold);
  font-size: 26rpx; font-weight: 900; margin-right: 14rpx; flex-shrink: 0; }
.t-fold.leaf { border-color: transparent; }
.t-art { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center;
  background: rgba(0, 0, 0, 0.25); border-radius: 10rpx; margin-right: 18rpx; flex-shrink: 0; }
.t-art.have { box-shadow: 0 0 12rpx rgba(76, 175, 80, 0.5); }
.t-art.lack { box-shadow: 0 0 12rpx rgba(232, 85, 85, 0.5); }
.t-name { font-size: 26rpx; color: var(--text); font-weight: 700; max-width: 320rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.t-count { font-size: 18rpx; color: var(--gold); margin-left: 10rpx; }
.t-flag { font-size: 14rpx; color: #3A2400; background: var(--gold); border-radius: 6rpx;
  padding: 2rpx 10rpx; margin-left: 12rpx; }
.t-have { font-size: 16rpx; color: #7CD86A; border: 1rpx solid rgba(76, 175, 80, 0.6);
  border-radius: 6rpx; padding: 0 8rpx; margin-left: 12rpx; }
.t-lack { font-size: 16rpx; color: #E85555; border: 1rpx solid rgba(232, 85, 85, 0.6);
  border-radius: 6rpx; padding: 0 8rpx; margin-left: 12rpx; }
.t-sub { font-size: 20rpx; color: var(--text-faint); margin-top: 6rpx; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap; max-width: 440rpx; }
.t-ops { display: flex; flex-shrink: 0; margin-left: 8rpx; }
.t-op { width: 52rpx; height: 52rpx; margin-left: 10rpx; border-radius: 10rpx;
  border: 2rpx solid var(--gold-faint); color: var(--gold); font-size: 26rpx; font-weight: 900;
  display: flex; align-items: center; justify-content: center; }
.t-op.add { border-color: rgba(76, 175, 80, 0.6); color: #7CD86A; }

/* 缺料 */
.miss { margin: 0 30rpx; padding: 10rpx 22rpx; }
.mi { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 2rpx dashed rgba(255, 215, 0, 0.12); }
.mi:last-child { border-bottom: none; }
.mi-art { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center;
  margin-right: 18rpx; background: rgba(232, 85, 85, 0.08); border-radius: 8rpx; flex-shrink: 0; }
.mi-n { font-size: 25rpx; color: var(--text); font-weight: 700; }
.mi-o { font-size: 20rpx; color: var(--text-faint); margin-top: 4rpx; }

/* 常用合成 */
.quick { white-space: nowrap; padding: 4rpx 0 10rpx 30rpx; }
.q-chip { display: inline-flex; flex-direction: column; align-items: center;
  width: 150rpx; padding: 20rpx 0 16rpx; margin-right: 18rpx; }
.q-chip:last-child { margin-right: 30rpx; }
.q-art { height: 72rpx; display: flex; align-items: center; margin-bottom: 10rpx; }
.q-n { font-size: 22rpx; color: var(--text); font-weight: 700; max-width: 130rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.pad-bottom { height: 200rpx; }

/* wiki 配方卡 */
.tc-sprite { width: 72rpx; height: 72rpx; }
.tc-ph { font-size: 40rpx; color: var(--text-faint); }
.mat-sprite { width: 56rpx; height: 56rpx; }
.sg-wiki { font-size: 17rpx; color: #4CE0E0; border: 2rpx solid #4CE0E066; border-radius: 6rpx; padding: 0 6rpx; margin-left: 8rpx; }
.wiki-note { text-align: center; font-size: 19rpx; color: var(--text-faint); margin-top: 16rpx; }

/* wiki 递归合成树 */
.wt-row { display: flex; align-items: center; padding: 12rpx 16rpx; border-bottom: 2rpx solid var(--line); }
.mat-sprite { width: 52rpx; height: 52rpx; }
.mat-n { font-size: 24rpx; font-weight: 600; color: var(--text); }
.wt-cyc { color: var(--text-faint); font-weight: 400; }
.wt-obt { font-size: 19rpx; color: var(--text-faint); margin-top: 4rpx; line-height: 1.5; }
.wt-detail { font-size: 26rpx; color: #4CE0E0; padding: 6rpx 12rpx; flex-shrink: 0; }
.wt-arrow { font-size: 22rpx; color: var(--gold); flex-shrink: 0; }

.sg-sprite { width: 52rpx; height: 52rpx; }

.sg-img { width: 52rpx; height: 52rpx; }
.fr-img { width: 52rpx; height: 52rpx; }
