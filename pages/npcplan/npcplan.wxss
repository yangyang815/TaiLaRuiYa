/* NPC 规划器 */
.np-root { padding: 0 26rpx 60rpx; }

/* 导航 */
.nav { display: flex; align-items: center; padding: 16rpx 0 12rpx; }
.nav-t { font-size: 36rpx; font-weight: 800; color: var(--text); flex: 1; text-align: center; }
.back { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; color: var(--gold, #FFD700); font-weight: 700; }
.nav-ph { width: 64rpx; }

/* 说明 */
.hint { padding: 18rpx 22rpx; margin-bottom: 20rpx;
  border: 2rpx solid rgba(127, 208, 255, 0.3); background: rgba(127, 208, 255, 0.06); }
.hint-t { font-size: 22rpx; color: var(--sub, #8a8a94); line-height: 1.6; }

/* Tab */
.tabs { display: flex; padding: 10rpx; margin-bottom: 24rpx; }
.tab-item { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 14rpx;
  font-size: 27rpx; font-weight: 700; color: var(--sub, #8a8a94); }
.tab-item.on { color: #FFD700; background: rgba(255, 215, 0, 0.13); }

/* 摘要 */
.sum-card { display: flex; align-items: center; padding: 28rpx 20rpx; margin-bottom: 22rpx;
  border: 2rpx solid rgba(255, 215, 0, 0.4);
  background: linear-gradient(150deg, rgba(255, 215, 0, 0.10), rgba(109, 232, 138, 0.05)); }
.sum-cell { flex: 1; display: flex; flex-direction: column; align-items: center; }
.sum-v { font-size: 60rpx; font-weight: 800; color: var(--text); line-height: 1.1;
  text-shadow: 0 0 24rpx rgba(255, 215, 0, 0.3); }
.sum-v.gold { color: #6de88a; }
.sum-k { font-size: 20rpx; color: var(--sub, #8a8a94); margin-top: 8rpx; }
.sum-divider { width: 2rpx; height: 70rpx; background: rgba(255, 255, 255, 0.1); }

/* 群落分组 */
.group { padding: 22rpx 24rpx; margin-bottom: 20rpx; }
.g-head { margin-bottom: 16rpx; gap: 12rpx; }
.g-icon { font-size: 38rpx; }
.g-biome { font-size: 30rpx; font-weight: 800; color: var(--text); }
.g-tag { margin-left: auto; font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 18rpx; }
.g-tag.ok { color: #6de88a; background: rgba(109, 232, 138, 0.12);
  border: 2rpx solid rgba(109, 232, 138, 0.4); }
.g-tag.no { color: #FF6B6B; background: rgba(255, 107, 107, 0.10);
  border: 2rpx solid rgba(255, 107, 107, 0.35); }

/* 成员行 */
.member { display: flex; align-items: center; flex-wrap: wrap; padding: 16rpx 12rpx;
  border-radius: 14rpx; transition: background 0.2s; }
.member:active, .member.open { background: rgba(255, 255, 255, 0.04); }
.member + .member { border-top: 2rpx solid rgba(255, 255, 255, 0.05); }
.m-avatar { width: 88rpx; height: 88rpx; border-radius: 16rpx; background: rgba(0, 0, 0, 0.28);
  display: flex; align-items: center; justify-content: center; margin-right: 18rpx; flex-shrink: 0; }
.m-avatar.sm { width: 72rpx; height: 72rpx; margin-right: 0; }
.m-emoji { font-size: 44rpx; }
.m-name-row { gap: 14rpx; }
.m-name { font-size: 28rpx; font-weight: 700; color: var(--text); }
.m-mood { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 14rpx; }
.m-mood.great { color: #6de88a; background: rgba(109, 232, 138, 0.14); }
.m-mood.good { color: #7fd0ff; background: rgba(127, 208, 255, 0.12); }
.m-mood.ok { color: #b8b8c2; background: rgba(184, 184, 194, 0.12); }
.m-mood.bad { color: #FF9F43; background: rgba(255, 159, 67, 0.12); }
.m-mood.awful { color: #FF6B6B; background: rgba(255, 107, 107, 0.12); }
.m-why-brief { gap: 14rpx; margin-top: 8rpx; }
.m-pct { font-size: 30rpx; font-weight: 800; color: var(--text); }
.m-pct.ok { color: #6de88a; }
.m-pylon { font-size: 19rpx; color: #6de88a; border: 2rpx solid rgba(109, 232, 138, 0.4);
  border-radius: 12rpx; padding: 0 10rpx; }
.m-arrow { font-size: 34rpx; color: var(--sub, #8a8a94); transition: transform 0.2s; }
.m-arrow.flip { transform: rotate(90deg); }

/* 明细 */
.m-detail { width: 100%; margin-top: 12rpx; padding: 16rpx 20rpx; border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.24); }
.md-row, .md-sum { padding: 8rpx 0; }
.md-row + .md-row { border-top: 2rpx solid rgba(255, 255, 255, 0.04); }
.md-k { font-size: 23rpx; color: var(--sub, #8a8a94); }
.md-v { font-size: 25rpx; font-weight: 700; color: #6de88a; }
.md-v.bad { color: #FF6B6B; }
.md-sum { border-top: 2rpx dashed rgba(255, 215, 0, 0.3); margin-top: 6rpx; padding-top: 12rpx; }
.md-sum .md-k { color: var(--text); font-weight: 700; }
.md-sum .md-v.ok { color: #6de88a; }
.md-sum .md-v { color: #FFD700; }

.foot { text-align: center; padding: 10rpx 0 30rpx; }
.foot-t { font-size: 20rpx; color: var(--sub, #8a8a94); line-height: 1.6; }

/* ===== 速查表 ===== */
.search-row { margin-bottom: 20rpx; }
.search-bar { display: flex; align-items: center; padding: 16rpx 22rpx; border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.05); border: 2rpx solid rgba(255, 255, 255, 0.08); }
.s-ico { margin-right: 12rpx; font-size: 26rpx; }
.s-input { flex: 1; font-size: 26rpx; color: var(--text); }

.pref { padding: 22rpx 24rpx; margin-bottom: 20rpx; }
.pref-empty { padding: 40rpx 24rpx; text-align: center; color: var(--sub, #9aa4b2); font-size: 26rpx; }
.p-head { gap: 16rpx; margin-bottom: 16rpx; }
.p-name { font-size: 29rpx; font-weight: 800; color: var(--text); }
.p-fix { font-size: 19rpx; color: #7fd0ff; border: 2rpx solid rgba(127, 208, 255, 0.4);
  border-radius: 10rpx; padding: 2rpx 10rpx; }
.p-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.p-cell { width: calc((100% - 24rpx) / 2); padding: 12rpx 16rpx; border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.04); box-sizing: border-box; }
.p-k { font-size: 19rpx; color: var(--sub, #8a8a94); }
.p-v { display: block; font-size: 22rpx; font-weight: 700; margin-top: 6rpx; line-height: 1.5; }
.p-v.love { color: #6de88a; }
.p-v.like { color: #7fd0ff; }
.p-v.dis { color: #FF9F43; }
.p-v.hate { color: #FF6B6B; }
.p-note { margin-top: 12rpx; }
.p-note-t { font-size: 20rpx; color: var(--sub, #8a8a94); }
