<view class="page-root {{themeClass}} np-root">

  <!-- 顶部导航（避让胶囊） -->
  <view class="nav" style="padding-top:{{statusBarHeight}}px;padding-right:{{capsuleRight}}px;">
    <view class="back tappable" bindtap="back">‹</view>
    <text class="nav-t">NPC 规划器</text>
    <view class="nav-ph" />
  </view>

  <!-- 说明横条 -->
  <view class="hint card">
    <text class="hint-t">💡 价格系数 ≤ 90% 的 NPC 会出售所在群落的晶塔。每组 2 人独居享 -5% 奖励。</text>
  </view>

  <!-- Tab：推荐规划 / 偏好速查 -->
  <view class="tabs card">
    <view class="tab-item tappable {{tab === 'plan' ? 'on' : ''}}" bindtap="onTab" data-k="plan">推荐规划</view>
    <view class="tab-item tappable {{tab === 'prefs' ? 'on' : ''}}" bindtap="onTab" data-k="prefs">偏好速查表</view>
  </view>

  <!-- ========== 推荐规划 ========== -->
  <block wx:if="{{tab === 'plan'}}">
    <!-- 摘要 -->
    <view class="sum-card card" wx:if="{{plan}}">
      <view class="sum-cell">
        <text class="sum-v">{{plan.avgPct}}%</text>
        <text class="sum-k px">平均价格系数</text>
      </view>
      <view class="sum-divider" />
      <view class="sum-cell">
        <text class="sum-v gold">{{plan.pylonCount}}/{{plan.pylonTotal}}</text>
        <text class="sum-k px">可解锁晶塔</text>
      </view>
    </view>

    <!-- 群落分组 -->
    <view class="group card" wx:for="{{plan.groups}}" wx:key="key" wx:for-item="g" wx:for-index="gi">
      <view class="g-head row">
        <text class="g-icon">{{g.biomeIcon}}</text>
        <text class="g-biome">{{g.biomeName}}</text>
        <text class="g-tag {{g.pylon ? 'ok' : 'no'}} px">{{g.pylon ? '✓ 晶塔可购' : '✗ 晶塔不可购'}}</text>
      </view>

      <!-- 成员 -->
      <view class="member tappable {{expanded === m.id ? 'open' : ''}}"
        wx:for="{{g.members}}" wx:key="id" wx:for-item="m"
        bindtap="onExpand" data-id="{{m.id}}">
        <view class="m-avatar">
          <pixel-icon wx:if="{{m.art}}" art-id="{{m.art}}" size="72" />
          <text wx:else class="m-emoji">{{m.emoji}}</text>
        </view>
        <view class="col flex-1">
          <view class="row m-name-row">
            <text class="m-name">{{m.name}}</text>
            <text class="m-mood {{m.mood.c}}">{{m.mood.t}}</text>
          </view>
          <view class="row m-why-brief">
            <text class="m-pct {{m.pylon ? 'ok' : ''}}">{{m.pct}}%</text>
            <text class="m-pylon px" wx:if="{{m.pylon}}">晶塔 ✓</text>
          </view>
        </view>
        <text class="m-arrow {{expanded === m.id ? 'flip' : ''}}">›</text>

        <!-- 价格明细 -->
        <view class="m-detail" wx:if="{{expanded === m.id}}">
          <view class="md-row row" wx:for="{{m.why}}" wx:key="t" wx:for-item="w">
            <text class="md-k flex-1">{{w.t}}</text>
            <text class="md-v {{w.bad ? 'bad' : ''}}">{{w.v}}</text>
          </view>
          <view class="md-sum row">
            <text class="md-k flex-1">最终价格系数</text>
            <text class="md-v {{m.pylon ? 'ok' : ''}}">{{m.pct}}%</text>
          </view>
        </view>
      </view>
    </view>

    <view class="foot">
      <text class="foot-t px">数据基于 1.4.4 官方偏好矩阵 · 同群落第二组请与第一组相距 25 格以上</text>
    </view>
  </block>

  <!-- ========== 偏好速查表 ========== -->
  <block wx:if="{{tab === 'prefs'}}">
    <view class="search-row">
      <view class="search-bar">
        <text class="s-ico">🔍</text>
        <input class="s-input" placeholder="搜索 NPC 名称..." value="{{prefKw}}" bindinput="onPrefKw" />
      </view>
    </view>

    <view class="pref-empty card" wx:if="{{prefKw && !prefs.length}}">
      <text class="px">未找到 "{{prefKw}}" 相关 NPC</text>
    </view>

    <view class="pref card" wx:for="{{prefs}}" wx:key="id" wx:for-item="p">
      <view class="row p-head">
        <view class="m-avatar sm">
          <pixel-icon wx:if="{{p.art}}" art-id="{{p.art}}" size="56" />
          <text wx:else class="m-emoji">{{p.emoji}}</text>
        </view>
        <text class="p-name flex-1">{{p.name}}</text>
        <text class="p-fix px" wx:if="{{p.fix}}">固定蘑菇群落</text>
      </view>
      <view class="p-grid">
        <view class="p-cell">
          <text class="p-k px">喜爱群落</text>
          <text class="p-v love">{{p.bLove}}</text>
        </view>
        <view class="p-cell">
          <text class="p-k px">喜欢群落</text>
          <text class="p-v like">{{p.bLike}}</text>
        </view>
        <view class="p-cell">
          <text class="p-k px">不喜欢群落</text>
          <text class="p-v dis">{{p.bDis}}</text>
        </view>
        <view class="p-cell">
          <text class="p-k px">讨厌群落</text>
          <text class="p-v hate">{{p.bHate}}</text>
        </view>
        <view class="p-cell">
          <text class="p-k px">喜爱邻居</text>
          <text class="p-v love">{{p.nLove}}</text>
        </view>
        <view class="p-cell">
          <text class="p-k px">喜欢邻居</text>
          <text class="p-v like">{{p.nLike}}</text>
        </view>
        <view class="p-cell">
          <text class="p-k px">不喜欢邻居</text>
          <text class="p-v dis">{{p.nDis}}</text>
        </view>
        <view class="p-cell">
          <text class="p-k px">讨厌邻居</text>
          <text class="p-v hate">{{p.nHate}}</text>
        </view>
      </view>
      <view class="p-note" wx:if="{{p.note}}"><text class="p-note-t px">{{p.note}}</text></view>
    </view>
  </block>
</view>
