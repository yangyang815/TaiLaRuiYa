/* 建造案例详情页 */
.bdetail-root { min-height: 100vh; padding: 0 24rpx 40rpx; box-sizing: border-box; }

.nav { display: flex; align-items: center; height: 88rpx; margin-bottom: 12rpx; }
.back { width: 64rpx; height: 64rpx; line-height: 60rpx; text-align: center;
  font-size: 44rpx; color: var(--text); border: 2rpx solid var(--line);
  border-radius: 14rpx; background: var(--card); }
.nav-t { flex: 1; text-align: center; font-size: 32rpx; font-weight: 800; color: var(--text); }
.nav-ph { width: 64rpx; }

/* 成品卡 */
.hero { position: relative; padding: 30rpx 24rpx 26rpx; margin-bottom: 24rpx; text-align: center;
  border: 2rpx solid rgba(76, 224, 224, 0.35);
  background: linear-gradient(160deg, rgba(76, 224, 224, 0.10), rgba(91, 155, 255, 0.08)); }
.hero-done { position: absolute; top: 16rpx; right: 16rpx; font-size: 20rpx; color: var(--green);
  background: rgba(60, 200, 90, 0.14); border-radius: 8rpx; padding: 4rpx 12rpx; }
.hero-art { display: flex; justify-content: center; margin-bottom: 16rpx; }
.hero-pic { width: 100%; border-radius: 16rpx; border: 2rpx solid rgba(76, 224, 224, 0.25);
  background: rgba(0, 0, 0, 0.25); }

/* 建造视频链接按钮 */
.video-btn { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 20rpx; margin-bottom: 16rpx;
  border-radius: 14rpx; border: 2rpx solid rgba(255, 107, 168, 0.4);
  background: rgba(255, 107, 168, 0.08); }
.video-btn:active { transform: scale(0.98); }
.video-src { font-size: 20rpx; color: var(--text-dim); margin: -6rpx 0 4rpx 8rpx; }
.video-disc { font-size: 18rpx; color: var(--text-dim); opacity: 0.75; margin: 0 0 16rpx 8rpx; }
.vb-play { width: 56rpx; height: 56rpx; border-radius: 50%; background: #FF6BA8; color: #fff;
  font-size: 24rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.vb-t { font-size: 25rpx; font-weight: 800; color: #FF8FBE; }
.vb-s { font-size: 20rpx; color: var(--text-dim); margin-top: 4rpx; }
.vb-go { font-size: 30rpx; color: #FF8FBE; }

/* 视频二维码弹窗 */
.vm-mask { position: fixed; inset: 0; z-index: 999; background: rgba(0, 0, 0, 0.72);
  display: flex; align-items: center; justify-content: center; }
.vm-card { width: 560rpx; border-radius: 24rpx; padding: 40rpx 36rpx 30rpx;
  background: var(--card, #221a35); border: 2rpx solid rgba(255, 107, 168, 0.35);
  display: flex; flex-direction: column; align-items: center; }
.vm-title { font-size: 30rpx; font-weight: 800; color: #FF8FBE; margin-bottom: 26rpx; }
.vm-qr-box { width: 380rpx; height: 380rpx; border-radius: 18rpx; overflow: hidden;
  background: #fff; display: flex; align-items: center; justify-content: center; }
.vm-qr { width: 380rpx; height: 380rpx; display: block; }
.vm-loading { font-size: 24rpx; color: #999; }
.vm-hint { font-size: 25rpx; font-weight: 700; color: var(--text, #e8e8ee); margin-top: 26rpx; text-align: center; }
.vm-hint.sub { font-size: 22rpx; font-weight: 400; color: var(--sub, #8a8a94); margin-top: 8rpx; }
.vm-copy { margin-top: 26rpx; font-size: 22rpx; color: #7ec8ff; text-decoration: underline; padding: 8rpx 16rpx; }
.vm-close { margin-top: 14rpx; width: 100%; text-align: center; padding: 18rpx 0;
  border-radius: 14rpx; background: rgba(255, 107, 168, 0.14); color: #FF8FBE;
  font-size: 27rpx; font-weight: 700; }
.vm-canvas { position: fixed; left: -2000rpx; top: 0; width: 300px; height: 300px; }
.hero-meta { display: flex; justify-content: center; margin-bottom: 20rpx; }
.hero-meta .tag { margin: 0 8rpx; }
.hero-spec { display: flex; align-items: center; justify-content: center; margin-bottom: 20rpx; }
.spec-i { align-items: center; margin: 0 30rpx; }
.spec-v { font-size: 24rpx; font-weight: 800; color: var(--text); }
.spec-k { font-size: 19rpx; color: var(--text-dim); margin-top: 4rpx; }
.spec-div { width: 2rpx; height: 44rpx; background: var(--line); }
.done-btn { text-align: center; padding: 16rpx 0; border-radius: 14rpx;
  font-size: 25rpx; font-weight: 700; color: #0E2A33; background: #4CE0E0; }
.done-btn.on { color: var(--green); background: rgba(60, 200, 90, 0.14); }

/* 材料 */
.mats { padding: 22rpx; }
.mat-row { display: flex; align-items: flex-start; padding: 12rpx 0; }
.mat-row + .mat-row { border-top: 2rpx solid var(--line); }
.mat-ic { font-size: 34rpx; line-height: 1.2; margin-right: 18rpx; width: 44rpx; text-align: center; }
.mat-n { font-size: 25rpx; font-weight: 700; color: var(--text); }
.mat-q { font-size: 21rpx; color: #4CE0E0; }
.mat-src { font-size: 20rpx; color: var(--text-dim); margin-top: 4rpx; }

/* 步骤 */
.step { padding: 24rpx; margin-bottom: 18rpx; }
.step-head { display: flex; align-items: center; margin-bottom: 12rpx; }
.step-no { font-size: 20rpx; font-weight: 800; color: #0E2A33; background: #FFD700;
  border-radius: 8rpx; padding: 4rpx 12rpx; margin-right: 14rpx; letter-spacing: 1rpx; }
.step-t { font-size: 27rpx; font-weight: 800; color: var(--text); }
.step-d { display: block; font-size: 22rpx; color: var(--text-dim); line-height: 1.7; margin-bottom: 16rpx; }
.step-art { display: flex; justify-content: center; padding: 14rpx 0 6rpx;
  background: rgba(0, 0, 0, 0.18); border-radius: 12rpx; }

/* 布局 */
.layout { padding: 22rpx; }
.lay-point { display: flex; align-items: flex-start; }
.lay-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #B57BFF;
  margin: 13rpx 14rpx 0 4rpx; flex-shrink: 0; }
.lay-p { flex: 1; font-size: 22rpx; color: var(--text); line-height: 1.7; }

/* 相关案例 */
.rel-row { display: flex; justify-content: space-between; margin-bottom: 10rpx; }
.rel-card { width: 31.5%; padding: 18rpx 12rpx 14rpx; text-align: center; box-sizing: border-box; }
.rel-art { display: flex; justify-content: center; margin-bottom: 10rpx; }
.rel-name { display: block; font-size: 22rpx; font-weight: 800; color: var(--text); margin-bottom: 6rpx; }
.rel-meta { font-size: 18rpx; color: var(--text-dim); }

/* 底部 */
.foot { text-align: center; padding: 30rpx 0 10rpx; }
.foot-t { font-size: 20rpx; color: var(--text-dim); letter-spacing: 4rpx; }
