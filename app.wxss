/* ============================================================
   泰拉瑞亚手册 · 暗黑奇幻像素设计系统
   主色：夜空蓝紫 #1A0E2E / 金 #FFD700 / 翠绿 #4CAF50
   辅色：暗红 #8B0000 / 灰白 #E0D6C8
   ============================================================ */

page {
  background: #120925;
  color: #E0D6C8;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Source Han Sans CN", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 主题变量 ---------- */
.page-root {
  --bg: #1A0E2E;
  --bg-deep: #120925;
  --bg-2: #241540;
  --card: rgba(64, 40, 104, 0.45);
  --card-solid: #2A1B45;
  --gold: #FFD700;
  --gold-deep: #B8860B;
  --gold-soft: rgba(255, 215, 0, 0.45);
  --gold-faint: rgba(255, 215, 0, 0.22);
  --green: #4CAF50;
  --green-deep: #2E7D32;
  --blood: #8B0000;
  --red: #E85555;
  --text: #E0D6C8;
  --text-dim: #A08FB8;
  --text-faint: #6E5F86;
  --line: rgba(255, 215, 0, 0.25);
  --shadow: rgba(0, 0, 0, 0.45);
  min-height: 100vh;
  background: var(--bg-deep);
  box-sizing: border-box;
}

/* 亮色（白天卷轴）主题 */
.page-root.theme-light {
  --bg: #F1EADA;
  --bg-deep: #E7DDC6;
  --bg-2: #F8F3E4;
  --card: rgba(255, 250, 236, 0.78);
  --card-solid: #FFFBE9;
  --gold: #A8790A;
  --gold-deep: #8A6408;
  --gold-soft: rgba(168, 121, 10, 0.4);
  --gold-faint: rgba(168, 121, 10, 0.2);
  --blood: #9A2A2A;
  --red: #C62828;
  --text: #38284F;
  --text-dim: #7C6E58;
  --text-faint: #A79B84;
  --line: rgba(140, 104, 24, 0.35);
  --shadow: rgba(90, 70, 30, 0.25);
}

/* ---------- 像素字体（英文/数字） ---------- */
.px {
  font-family: "PressStart2P", "Press Start 2P", "Courier New", monospace;
  letter-spacing: 1rpx;
}

/* ---------- 通用布局 ---------- */
.row { display: flex; align-items: center; }
.col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; min-width: 0; }
.safe-bottom { padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx); }

/* 自定义导航占位 */
.nav-block {
  position: relative;
  z-index: 50;
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  box-shadow: 0 6rpx 24rpx var(--shadow), inset 0 0 40rpx rgba(255, 215, 0, 0.04);
  box-sizing: border-box;
}
.card-gold {
  border-color: var(--gold-soft);
  box-shadow: 0 0 22rpx rgba(255, 215, 0, 0.16), 0 6rpx 24rpx var(--shadow);
}

/* 金色像素边框标题带 */
.sec-title {
  display: flex;
  align-items: center;
  padding: 26rpx 8rpx 20rpx;
}
.sec-title .diamond {
  width: 16rpx; height: 16rpx;
  background: var(--gold);
  margin-right: 14rpx;
  box-shadow: 0 0 12rpx var(--gold-soft);
  transform: rotate(45deg);
}
.sec-title .t {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text);
  letter-spacing: 2rpx;
}
.sec-title .more {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-dim);
}

/* ---------- 按钮 ---------- */
.btn-gold {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 34rpx;
  background: linear-gradient(180deg, #FFE55C 0%, #FFD700 45%, #C9A400 100%);
  color: #4A2B00;
  font-size: 26rpx;
  font-weight: 800;
  border-radius: 10rpx;
  border: 2rpx solid #FFF0B0;
  box-shadow: 0 4rpx 0 #8A6D00, 0 0 22rpx rgba(255, 215, 0, 0.35);
}
.btn-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 30rpx;
  background: rgba(255, 215, 0, 0.08);
  color: var(--gold);
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 10rpx;
  border: 2rpx solid var(--gold-faint);
}

/* 按压微交互：下沉 + 回弹 */
.tappable {
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.2s ease;
}
.tappable.pressed {
  transform: scale(0.94) translateY(4rpx);
  filter: brightness(1.25);
}

/* ---------- 标签 / 筹码 ---------- */
.chip {
  flex-shrink: 0;
  padding: 10rpx 26rpx;
  font-size: 24rpx;
  color: var(--text-dim);
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 999rpx;
  margin-right: 16rpx;
  transition: all 0.2s ease;
}
.page-root.theme-light .chip { background: rgba(120, 96, 40, 0.08); border-color: rgba(120, 96, 40, 0.18); }
.chip.on {
  color: #3A2400;
  background: linear-gradient(180deg, #FFE55C, #E5B800);
  border-color: #FFF0B0;
  font-weight: 800;
  box-shadow: 0 0 16rpx rgba(255, 215, 0, 0.4);
}

/* 类型徽标 */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  border-radius: 6rpx;
  border: 1rpx solid currentColor;
  line-height: 1.5;
}
.tag-boss  { color: #E85555; background: rgba(139, 0, 0, 0.25); }
.tag-item  { color: #FFD700; background: rgba(255, 215, 0, 0.12); }
.tag-mon   { color: #FF9C40; background: rgba(255, 156, 64, 0.12); }
.tag-strat { color: #4CE0E0; background: rgba(76, 224, 224, 0.12); }
.tag-seed  { color: #B57BFF; background: rgba(122, 66, 204, 0.16); }
.tag-npc   { color: #7CE87C; background: rgba(60, 200, 90, 0.14); }

/* ---------- 输入框 ---------- */
.input-dark {
  background: rgba(10, 5, 24, 0.55);
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  color: var(--text);
  font-size: 26rpx;
  padding: 16rpx 24rpx;
  box-shadow: inset 0 2rpx 10rpx rgba(0, 0, 0, 0.4);
}
.page-root.theme-light .input-dark { background: rgba(255, 255, 255, 0.75); }

/* ---------- 动效 ---------- */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(26rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.fade-in { animation: fadeUp 0.4s ease both; }

@keyframes popIn {
  0%   { opacity: 0; transform: scale(0.6); }
  70%  { transform: scale(1.05); }
  100% { opacity: 1; transform: scale(1); }
}
.pop-in { animation: popIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both; }

@keyframes blinkSteps { 50% { opacity: 0.25; } }
.blink { animation: blinkSteps 0.9s steps(2, jump-none) infinite; }

@keyframes spinSteps { to { transform: rotate(360deg); } }
.pixel-loader {
  width: 48rpx; height: 48rpx;
  border: 6rpx solid var(--gold-faint);
  border-top-color: var(--gold);
  border-radius: 4rpx;
  animation: spinSteps 0.9s steps(8) infinite;
}

@keyframes floaty {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-10rpx); }
}
.floaty { animation: floaty 2.6s ease-in-out infinite; }

@keyframes twinkle {
  0%, 100% { opacity: 0.15; transform: scale(0.8); }
  50%      { opacity: 0.9; transform: scale(1.15); }
}

@keyframes starFall {
  0%   { transform: translateY(-60rpx); opacity: 0; }
  8%   { opacity: 0.85; }
  100% { transform: translateY(110vh); opacity: 0; }
}

/* 星星粒子（首页 / 详情页背景） */
.star {
  position: absolute;
  width: 8rpx; height: 8rpx;
  background: #FFE98A;
  box-shadow: 0 0 10rpx rgba(255, 233, 138, 0.9);
  animation-name: starFall, twinkle;
  animation-timing-function: linear, ease-in-out;
  animation-iteration-count: infinite, infinite;
  top: 0;
  border-radius: 2rpx;
}

/* Boss 详情页专属颗粒 */
@keyframes ashFall {
  0%   { transform: translateY(-40rpx) translateX(0); opacity: 0; }
  10%  { opacity: 0.8; }
  100% { transform: translateY(105vh) translateX(30rpx); opacity: 0; }
}
.ash {
  position: absolute;
  top: 0;
  border-radius: 4rpx;
  animation: ashFall linear infinite;
}

/* ---------- 半屏弹窗（层级需高于底部导航栏 z-index:999） ---------- */
.mask {
  position: fixed; inset: 0;
  background: rgba(6, 2, 16, 0.75);
  z-index: 1200;
}
.sheet {
  position: fixed;
  left: 0; right: 0;
  /* 自定义 tabBar 渲染在页面独立层之上，页面元素无法覆盖，只能整体上移避开。
     tabBar 实际高度约 125~135rpx（含文字行高差异），145rpx 留足安全边距 */
  bottom: calc(env(safe-area-inset-bottom) + 145rpx);
  z-index: 1201;
  background: linear-gradient(180deg, #2E1C4D 0%, #1E1136 100%);
  border-top: 3rpx solid var(--gold-soft);
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -10rpx 60rpx rgba(0, 0, 0, 0.6), 0 0 40rpx rgba(255, 215, 0, 0.08);
  padding-bottom: 30rpx;
  animation: sheetUp 0.3s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.page-root.theme-light .sheet { background: linear-gradient(180deg, #FFFCF0, #F3EBD5); }
@keyframes sheetUp {
  from { transform: translateY(60%); opacity: 0.4; }
  to   { transform: translateY(0); opacity: 1; }
}
.sheet-handle {
  width: 72rpx; height: 8rpx;
  border-radius: 8rpx;
  background: var(--gold-faint);
  margin: 18rpx auto 6rpx;
}

/* ---------- 稀有度光晕工具类 ---------- */
.glow { border-radius: 14rpx; }

/* ---------- 分割线 ---------- */
.hr {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--gold-faint), transparent);
  margin: 20rpx 0;
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 90rpx 0;
  text-align: center;
  color: var(--text-faint);
  font-size: 24rpx;
}
.empty .e-icon { font-size: 64rpx; margin-bottom: 16rpx; filter: grayscale(0.4); }
