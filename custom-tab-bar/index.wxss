.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  background: rgba(16, 8, 32, 0.97);
  border-top: 3rpx solid rgba(255, 215, 0, 0.35);
  box-shadow: 0 -6rpx 30rpx rgba(0, 0, 0, 0.55), 0 -2rpx 24rpx rgba(255, 215, 0, 0.08);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0 10rpx;
}
.tab-icon {
  padding: 6rpx;
  border-radius: 10rpx;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.tab-icon.on {
  filter: drop-shadow(0 0 12rpx rgba(255, 215, 0, 0.65));
  transform: translateY(-6rpx) scale(1.08);
}
.tab-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8E7FA6;
  letter-spacing: 2rpx;
  transition: color 0.2s;
}
.tab-text.on {
  color: #FFD700;
  font-weight: 800;
  text-shadow: 0 0 12rpx rgba(255, 215, 0, 0.5);
}

/* 白天模式 */
.tabbar.theme-light {
  background: rgba(248, 243, 228, 0.97);
  border-top-color: rgba(168, 121, 10, 0.35);
  box-shadow: 0 -6rpx 30rpx rgba(120, 96, 40, 0.18);
}
.tabbar.theme-light .tab-text { color: #A79B84; }
.tabbar.theme-light .tab-text.on {
  color: #A8790A;
  text-shadow: none;
}

/* ---------- biome 主题换装（底色对齐 --head-bg 鲜艳顶色） ---------- */
.tabbar.theme-jungle { background: rgba(46, 90, 36, 0.97); border-top-color: rgba(200, 232, 90, 0.35); }
.tabbar.theme-jungle .tab-text { color: #A8C878; }
.tabbar.theme-jungle .tab-text.on { color: #C8E85A; text-shadow: 0 0 12rpx rgba(200, 232, 90, 0.5); }
.tabbar.theme-jungle .tab-icon.on { filter: drop-shadow(0 0 12rpx rgba(200, 232, 90, 0.65)); }
.tabbar.theme-corruption { background: rgba(61, 34, 102, 0.97); border-top-color: rgba(199, 125, 255, 0.35); }
.tabbar.theme-corruption .tab-text { color: #B29DD8; }
.tabbar.theme-corruption .tab-text.on { color: #C77DFF; text-shadow: 0 0 12rpx rgba(199, 125, 255, 0.5); }
.tabbar.theme-corruption .tab-icon.on { filter: drop-shadow(0 0 12rpx rgba(199, 125, 255, 0.65)); }
.tabbar.theme-crimson { background: rgba(94, 30, 40, 0.97); border-top-color: rgba(255, 158, 107, 0.35); }
.tabbar.theme-crimson .tab-text { color: #D4A094; }
.tabbar.theme-crimson .tab-text.on { color: #FF9E6B; text-shadow: 0 0 12rpx rgba(255, 158, 107, 0.5); }
.tabbar.theme-crimson .tab-icon.on { filter: drop-shadow(0 0 12rpx rgba(255, 158, 107, 0.65)); }
.tabbar.theme-lunar { background: rgba(18, 48, 94, 0.97); border-top-color: rgba(98, 224, 240, 0.35); }
.tabbar.theme-lunar .tab-text { color: #8AB0D8; }
.tabbar.theme-lunar .tab-text.on { color: #62E0F0; text-shadow: 0 0 12rpx rgba(98, 224, 240, 0.5); }
.tabbar.theme-lunar .tab-icon.on { filter: drop-shadow(0 0 12rpx rgba(98, 224, 240, 0.65)); }
.tabbar.theme-halloween { background: rgba(94, 58, 18, 0.97); border-top-color: rgba(255, 174, 66, 0.35); }
.tabbar.theme-halloween .tab-text { color: #D2AC74; }
.tabbar.theme-halloween .tab-text.on { color: #FFAE42; text-shadow: 0 0 12rpx rgba(255, 174, 66, 0.5); }
.tabbar.theme-halloween .tab-icon.on { filter: drop-shadow(0 0 12rpx rgba(255, 174, 66, 0.65)); }
.tabbar.theme-hallow { background: rgba(252, 248, 253, 0.97); border-top-color: rgba(192, 68, 200, 0.35); box-shadow: 0 -6rpx 30rpx rgba(110, 80, 160, 0.2); }
.tabbar.theme-hallow .tab-text { color: #9488B0; }
.tabbar.theme-hallow .tab-text.on { color: #C044C8; text-shadow: 0 0 12rpx rgba(192, 68, 200, 0.4); }
.tabbar.theme-hallow .tab-icon.on { filter: drop-shadow(0 0 12rpx rgba(192, 68, 200, 0.55)); }
