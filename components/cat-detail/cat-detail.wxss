/* 全物品图鉴详情弹窗（自包含样式，随主题变量适配） */
.cd-mask { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.55); z-index: 120; }
.cd-sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 121;
  background: var(--card); border-radius: 28rpx 28rpx 0 0; padding: 20rpx 30rpx 40rpx; }
.cd-handle { width: 72rpx; height: 8rpx; border-radius: 4rpx; background: var(--line); margin: 0 auto 18rpx; }
.cd-head { display: flex; align-items: center; }
.cd-imgbox { width: 96rpx; height: 96rpx; border-radius: 14rpx; background: rgba(0, 0, 0, 0.3);
  display: flex; align-items: center; justify-content: center; margin-right: 20rpx; flex-shrink: 0; }
.cd-img { width: 64rpx; height: 64rpx; }
.cd-n { font-size: 32rpx; font-weight: 800; color: var(--text); }
.cd-en { font-size: 20rpx; color: var(--text-faint); margin-top: 4rpx; }
.cd-chips { display: flex; gap: 10rpx; margin-top: 10rpx; flex-wrap: wrap; }
.cd-chip { font-size: 19rpx; color: var(--gold); border: 2rpx solid var(--gold-faint);
  border-radius: 6rpx; padding: 2rpx 10rpx; }
.cd-body { margin-top: 20rpx; max-height: 46vh; }
.cd-row { display: flex; padding: 12rpx 0; border-bottom: 2rpx solid var(--line); font-size: 24rpx; }
.cd-row > .flex-1 { color: var(--text); line-height: 1.6; }
.cd-k { width: 150rpx; color: var(--text-faint); flex-shrink: 0; }
.cd-btn { margin-top: 24rpx; text-align: center; padding: 16rpx 0; border-radius: 12rpx;
  font-size: 26rpx; font-weight: 700; color: #0E2A33; background: #4CE0E0; }
