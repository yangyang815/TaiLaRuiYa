/* 建筑外观拼贴：天空 + 方块网格 */
.bh { position: relative; overflow: hidden; border-radius: 14rpx; }

/* 白天天空渐变 */
.bh-sky { position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, #6db5e8 0%, #a3d6f2 60%, #d6eef9 100%); }

/* 装饰云 */
.bh-cloud { position: absolute; background: rgba(255, 255, 255, 0.85);
  border-radius: 50%; }
.bh-cloud.c1 { width: 90rpx; height: 26rpx; left: 8%; top: 12%; }
.bh-cloud.c2 { width: 60rpx; height: 20rpx; right: 10%; top: 22%; }

/* 方块网格 */
.bh-grid { position: relative; display: flex; flex-direction: column;
  width: 100%; height: 100%; }
.bh-row { flex: 1; display: flex; min-height: 0; }
.bh-c { flex: 1; height: 100%; }
.bh-air { background: transparent; }
