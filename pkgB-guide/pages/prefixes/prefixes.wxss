/* 词条图鉴 */
.prefixes-root { min-height: 100vh; padding: 0 24rpx 40rpx; box-sizing: border-box; }

/* 顶部导航 */
.nav { display: flex; align-items: center; height: 88rpx; margin-bottom: 12rpx; }
.back { width: 64rpx; height: 64rpx; line-height: 60rpx; text-align: center;
  font-size: 44rpx; color: var(--text); border: 2rpx solid var(--line);
  border-radius: 14rpx; background: var(--card); }
.nav-t { flex: 1; text-align: center; font-size: 32rpx; font-weight: 800; color: var(--text); }
.nav-ph { width: 64rpx; }

/* 头部 */
.hero { display: flex; align-items: center; padding: 20rpx 24rpx; margin-bottom: 20rpx;
  border: 2rpx solid rgba(255, 110, 199, 0.35); border-radius: 20rpx;
  background: linear-gradient(120deg, rgba(255, 110, 199, 0.14), rgba(122, 66, 204, 0.12)); }
.hero-art { margin-right: 24rpx; }
.hero-t { font-size: 26rpx; color: #FF8FD0; letter-spacing: 4rpx; }
.hero-s { font-size: 24rpx; color: var(--text); margin-top: 6rpx; }
.hero-stat { font-size: 20rpx; color: var(--text-dim); margin-top: 8rpx; }
.floaty { animation: floaty 3s ease-in-out infinite; }
@keyframes floaty { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10rpx); } }

/* 分类 */
.cat-scroll { white-space: nowrap; margin-bottom: 20rpx; }
.cat-scroll .chip { display: inline-block; margin-right: 14rpx; }

/* 武器词条卡片 */
.sec-list { display: flex; flex-direction: column; }
.p-card { padding: 22rpx; margin-bottom: 18rpx; }
.p-card.bad { border: 2rpx solid rgba(232, 85, 85, 0.4); }
.pc-top { display: flex; align-items: center; }
.pc-art { margin-right: 20rpx; flex-shrink: 0; }
.pc-name-row { align-items: center; }
.pc-name { font-size: 30rpx; font-weight: 800; color: var(--text); }
.pc-en { font-size: 18rpx; color: var(--text-dim); margin-left: 12rpx; letter-spacing: 1rpx; }
.tag-best { color: #FFD86B; background: rgba(255, 215, 0, 0.12); margin-left: 12rpx; }
.tag-common { color: #7CE87C; background: rgba(60, 200, 90, 0.12); margin-left: 12rpx; }
.tag-bad { color: #E85555; background: rgba(232, 85, 85, 0.12); margin-left: 12rpx; }
.pc-cls { font-size: 20rpx; color: var(--text-dim); margin-top: 8rpx; }

/* 属性芯片 */
.pc-stats { flex-wrap: wrap; margin-top: 16rpx; }
.stat { display: flex; align-items: center; margin: 0 14rpx 12rpx 0;
  border-radius: 10rpx; padding: 6rpx 14rpx; }
.stat.up { background: rgba(60, 200, 90, 0.12); }
.stat.down { background: rgba(232, 85, 85, 0.12); }
.stat-l { font-size: 20rpx; color: var(--text-dim); margin-right: 8rpx; }
.stat.up .stat-v { font-size: 22rpx; font-weight: 700; color: #7CE87C; }
.stat.down .stat-v { font-size: 22rpx; font-weight: 700; color: #E85555; }
.pc-note { display: block; font-size: 23rpx; color: var(--text-dim); line-height: 1.7; margin-top: 6rpx; }

/* 饰品词条卡 */
.acc-card { padding: 22rpx; margin-bottom: 18rpx; }
.acc-head { align-items: center; }
.acc-ico { margin-right: 20rpx; flex-shrink: 0; }
.acc-title-row { align-items: center; }
.acc-name { font-size: 29rpx; font-weight: 800; color: var(--text); }
.acc-best { font-size: 18rpx; color: #FFD86B; border: 2rpx solid rgba(255, 215, 0, 0.45);
  border-radius: 8rpx; padding: 2rpx 10rpx; margin-left: 14rpx; }
.acc-desc { font-size: 22rpx; color: var(--text-dim); line-height: 1.6; margin-top: 8rpx; }
.acc-tiers { margin-top: 18rpx; justify-content: space-between; }
.tier { flex: 1; display: flex; flex-direction: column; align-items: center;
  border: 2rpx solid var(--line); border-radius: 14rpx; padding: 14rpx 4rpx;
  margin-right: 12rpx; box-sizing: border-box; }
.tier:last-child { margin-right: 0; }
.tier.top { border-color: rgba(255, 215, 0, 0.55);
  background: linear-gradient(180deg, rgba(255, 215, 0, 0.1), transparent); }
.tier-name { font-size: 24rpx; font-weight: 700; color: var(--text); }
.tier.top .tier-name { color: #FFD86B; }
.tier-en { font-size: 16rpx; color: var(--text-dim); margin-top: 4rpx; letter-spacing: 1rpx; }
.tier-val { font-size: 26rpx; font-weight: 800; color: #7CE87C; margin-top: 8rpx; }
.tier.top .tier-val { color: #FFD86B; }

/* 重铸指南 */
.tip { padding: 18rpx 20rpx; margin: 12rpx 0; }
.tip-head { display: flex; align-items: center; }
.tip-i { width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; flex-shrink: 0;
  font-size: 22rpx; color: #FF8FD0; border: 2rpx solid rgba(255, 143, 208, 0.5);
  border-radius: 10rpx; margin-right: 16rpx; }
.tip-t { font-size: 26rpx; font-weight: 800; color: var(--text); flex: 1; }
.tip-d { display: block; font-size: 23rpx; color: var(--text-dim); line-height: 1.75; margin-top: 10rpx; }

/* 弹窗 */
.mask { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.6); z-index: 60; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 61;
  max-height: 82vh; display: flex; flex-direction: column;
  background: var(--bg); border-top: 2rpx solid var(--line);
  border-radius: 28rpx 28rpx 0 0; padding: 12rpx 24rpx 0; box-sizing: border-box; }
.sheet-handle { width: 72rpx; height: 8rpx; border-radius: 4rpx;
  background: var(--line); margin: 8rpx auto 14rpx; }
.sh-head { display: flex; align-items: center; padding-bottom: 18rpx;
  border-bottom: 2rpx solid var(--line); }
.sh-art { margin-right: 22rpx; flex-shrink: 0; filter: drop-shadow(0 0 16rpx rgba(255, 143, 208, 0.35)); }
.sh-title { font-size: 32rpx; font-weight: 800; color: var(--text); line-height: 1.4; }
.sh-tags { margin-top: 10rpx; align-items: center; }
.sh-cls { font-size: 20rpx; color: var(--text-dim); margin-left: 14rpx; }
.sh-body { flex: 1; overflow: hidden; max-height: calc(82vh - 220rpx); }
.sh-stats { margin-top: 18rpx; }
.sh-note { display: block; font-size: 24rpx; color: var(--text); line-height: 1.7;
  padding: 12rpx 0 6rpx; font-weight: 600; }
.sh-detail { padding: 18rpx 20rpx; margin: 12rpx 0; }
.sh-d-t { font-size: 23rpx; color: var(--text-dim); line-height: 1.75; }
.sh-pad { height: 40rpx; }

/* 底部 */
.foot { text-align: center; padding: 30rpx 0 10rpx; }
.foot-t { font-size: 20rpx; color: var(--text-dim); letter-spacing: 4rpx; }
